  createdBy User     @relation("LeaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  rentInvoices LeaseRentInvoice[]

  @@unique([entityId, leaseNumber])
  @@index([entityId, status])
  @@index([tenantId])
  @@index([unitId, status])
  @@map("leases")
}

/// Links one periodic rent billing to the ARInvoice that actually carries
/// the financial record Ã¢â‚¬â€ this table is a thin pointer, not a duplicate
/// ledger.
model LeaseRentInvoice {
  id           String   @id @default(uuid())
  leaseId      String
  arInvoiceId  String   @unique
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime @default(now())

  lease     Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  arInvoice ARInvoice @relation(fields: [arInvoiceId], references: [id], onDelete: Restrict)

  @@index([leaseId])
  @@map("lease_rent_invoices")
}

// =====================================================================
// PHASE 5A Ã¢â‚¬â€ REAL ESTATE: FACILITY MANAGEMENT / MAINTENANCE REQUESTS
// (additive) Ã¢â‚¬â€ Release D
// =====================================================================
// A Facility is a physical asset/amenity to be maintained Ã¢â‚¬â€ either a
// common-area asset (projectId set, e.g. a generator or lift serving a
// whole estate) or an in-unit fixture (unitId set). A MaintenanceRequest
// is the work-order raised against a Facility (or, for a general
// tenant-reported issue with no tracked asset yet, against a bare unit).
// Both share FacilityCategory rather than each inventing their own
// category list. Billing does not invent AP posting logic: closing a
// request with a cost reuses AccountsPayableService.createInvoice() Ã¢â‚¬â€
// the same VendorInvoice/PostingEngine path Procurement and ad-hoc AP
// bills already use Ã¢â‚¬â€ rather than posting a journal entry here.
// Decommissioning a safety-relevant Facility goes through the existing
// Workflow Engine, the same integration shape MortgageService and
// HandoverService already use.

enum FacilityCategory {
  MECHANICAL
  ELECTRICAL
  PLUMBING
  HVAC
  SECURITY
  STRUCTURAL
  AMENITY
  OTHER
}

enum FacilityStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum MaintenanceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestSource {
  TENANT_REPORTED
  FACILITY_INSPECTION
  INTERNAL
}

model Facility {
  id                 String           @id @default(uuid())
  entityId           String
  projectId          String?
  unitId             String?
  name               String
  category           FacilityCategory
  description        String?
  status             FacilityStatus   @default(OPERATIONAL)
  vendorId           String?
  installDate        DateTime?
  lastServicedAt     DateTime?
  nextServiceDueAt   DateTime?
  decommissionedAt   DateTime?
  decommissionReason String?
  workflowInstanceId String?
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy User     @relation("FacilityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  maintenanceRequests MaintenanceRequest[]

  @@index([entityId, status])
  @@index([projectId])
  @@index([unitId])
  @@map("facilities")
}

model MaintenanceRequest {
  id                   String                    @id @default(uuid())
  entityId             String
  facilityId           String?
  unitId               String?
  tenantId             String?
  category             FacilityCategory
  priority             MaintenancePriority        @default(MEDIUM)
  source               MaintenanceRequestSource   @default(INTERNAL)
  description          String
  status               MaintenanceRequestStatus   @default(OPEN)
  reportedById         String
  assignedVendorId     String?
  assignedAt           DateTime?
  targetResolutionDate DateTime?
  costEstimate         Decimal?                  @db.Decimal(18, 2)
  actualCost           Decimal?                  @db.Decimal(18, 2)
  vendorInvoiceId      String?                   @unique
  resolvedAt           DateTime?
  resolutionNotes      String?
  closedAt             DateTime?
  cancelledReason      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  facility       Facility?      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  unit           Unit?          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reportedBy     User           @relation("MaintenanceReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedVendor Vendor?        @relation("MaintenanceAssignedVendor", fields: [assignedVendorId], references: [id], onDelete: Restrict)
  vendorInvoice  VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)

  @@index([entityId, status])
  @@index([facilityId])
  @@index([unitId])
  @@index([tenantId])
  @@map("maintenance_requests")
}

// =====================================================================
// RELEASE J Ã¢â‚¬â€ SECURITY HARDENING PART 1 (additive)
// Password Policy Engine, Login History, Account Lockout.
// =====================================================================
// Extends the existing auth.service.ts (bcrypt + JWT + RefreshToken)
// rather than replacing it Ã¢â‚¬â€ see AuthService.validateCredentials()/
// login(), which now call into PasswordPolicyService/LoginHistoryService/
// AccountLockoutService instead of reimplementing password hashing or
// token issuance. entityId is nullable on AuthSecurityPolicy so exactly
// one GLOBAL policy (entityId = null) can exist alongside optional
// per-entity overrides (Postgres unique indexes allow multiple NULLs);
// this release's login flow only resolves the GLOBAL policy Ã¢â‚¬â€ see the
// "Known limitation" note in the release report for why per-entity
// resolution is deferred rather than guessed at here.

model AuthSecurityPolicy {
  id                     String   @id @default(uuid())
  entityId               String?
  minLength              Int      @default(8)
  requireUppercase       Boolean  @default(true)
  requireLowercase       Boolean  @default(true)
  requireNumber          Boolean  @default(true)
  requireSymbol          Boolean  @default(false)
  expiryDays             Int?
  historyCount           Int      @default(5)
  maxFailedLoginAttempts Int      @default(5)
  lockoutDurationMinutes Int      @default(30)
  isActive               Boolean  @default(true)
  createdById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  entity    Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User    @relation("AuthSecurityPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([entityId])
  @@map("auth_security_policies")
}

/// Prior password hashes for reuse-prevention. CASCADE on user deletion Ã¢â‚¬â€
/// same reasoning as RefreshToken: no independent value once the owning
/// user is gone, and it isn't itself a compliance record (LoginHistory
/// below is, and uses SetNull instead).
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation("PasswordHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

enum LoginEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

/// userId is nullable (a failed attempt against an email that matches no
/// user must still be recorded for security monitoring) and onDelete is
/// SetNull rather than Cascade Ã¢â‚¬â€ unlike PasswordHistory/RefreshToken,
/// this IS a security compliance record and should outlive the user row.
model LoginHistory {
  id             String         @id @default(uuid())
  userId         String?
  emailAttempted String
  eventType      LoginEventType
  ipAddress      String?
  userAgent      String?
  failureReason  String?
  createdAt      DateTime       @default(now())

  user User? @relation("LoginHistoryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([emailAttempted])
  @@index([createdAt])
  @@map("login_history")
}

// =====================================================================
// TREASURY (referenced by Phase 1 kernel; full module built in Phase 5)
// =====================================================================

model BankAccount {
  id            String   @id @default(uuid())
  entityId      String
  accountName   String
  accountNumber String
  bankName      String
  currency      String   @default("NGN")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  paymentVouchers PaymentVoucher[]
  receipts        Receipt[]
  bankStatements  BankStatement[]
  reconciliationSessions ReconciliationSession[]

  // Release IF.1, Checkpoint C (additive)
  monoLinkedAccounts MonoLinkedAccount[]

  @@unique([entityId, accountNumber])
  @@map("bank_accounts")
}

// =====================================================================
// Release IF.1, Checkpoint C Ã¢â‚¬â€ MONO CONNECT ACCOUNT LINKING (additive)
// =====================================================================
// The linked-account model MonoProvider's Checkpoint B doc comment
// flagged as the prerequisite for its stub methods: Mono is an
// account-linking aggregator (unlike a payment gateway's on-demand NIBSS
// lookup), so every real data call needs a Mono `accountId` obtained
// once via the Mono Connect widget + a server-side code exchange, not an
// arbitrary accountNumber+bankCode a caller can supply per-request. This
// table is that mapping. Deliberately NOT a 1:1 with BankAccount Ã¢â‚¬â€ a row
// is kept (status REVOKED) rather than deleted when unlinked, preserving
// which Mono accountId a given historical statement import/balance
// check actually came from.

enum MonoLinkStatus {
  ACTIVE
  REVOKED
  /// Release IF.1, Checkpoint G Ã¢â‚¬â€ set by MonoWebhookHandler on a
  /// mono.events.reauthorisation_required callback (e.g. the linked
  /// institution enabled MFA, or the consent otherwise lapsed). Cleared
  /// back to ACTIVE on the matching mono.events.account_reauthorized
  /// callback. fetchStatement/fetchBalance/validateAccount all key off
  /// ACTIVE already (resolveActiveLinkedAccount), so a REQUIRES_REAUTH
  /// row is automatically excluded from them with no further change Ã¢â‚¬â€
  /// this checkpoint only had to teach something to SET the status.
  REQUIRES_REAUTH
}

model MonoLinkedAccount {
  id                  String         @id @default(uuid())
  bankAccountId       String
  /// Mono's own account id Ã¢â‚¬â€ globally unique per Mono, obtained from the
  /// POST /v2/account/auth code-exchange response.
  monoAccountId       String         @unique
  institutionName     String?
  accountNumberMasked String?
  currency            String?
  status              MonoLinkStatus @default(ACTIVE)
  linkedById          String
  linkedAt            DateTime       @default(now())
  revokedAt           DateTime?
  /// Release IF.1, Checkpoint G Ã¢â‚¬â€ when this row most recently entered
  /// REQUIRES_REAUTH, cleared (set back to null) on reauthorisation.
  reauthRequiredAt    DateTime?
  /// Release IF.1, Checkpoint H Ã¢â‚¬â€ the end of the last window
  /// MonoStatementSyncProcessor successfully imported through. Null means
  /// never synced by the scheduled job (a manual import via
  /// POST .../import-statement does NOT update this Ã¢â‚¬â€ see that
  /// processor's own doc comment for why the two are deliberately
  /// independent watermarks).
  lastSyncedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  linkedBy    User        @relation("MonoLinkedAccountLinkedBy", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([bankAccountId])
  @@index([status])
  @@map("mono_linked_accounts")
}

// =====================================================================
// TRANSFER APIS Ã¢â‚¬â€ Checkpoint B (additive)
// =====================================================================
// Persistence for the TransferProvider abstraction
// (transfers/transfer-provider.interface.ts, Checkpoint A). No approval
// gate, no limit field Ã¢â‚¬â€ explicitly confirmed scope, see that file's
// "SCOPE DECISION" note. workflowInstanceId is nullable/unused by
// default: available for a future optional policy layer to populate if
// an admin ever turns approval on, not required by this model itself.
//
// `reference` carries the UNIQUE constraint that makes idempotency a
// database-enforced guarantee, not just a documented contract on the
// interface Ã¢â‚¬â€ a retried initiateTransfer() call with the same reference
// cannot create a second row no matter what a provider implementation
// does or doesn't check on its own side.

enum BankTransferStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

model BankTransfer {
  id                      String             @id @default(uuid())
  entityId                String
  providerCode            String
  providerTransferId      String?
  reference               String             @unique
  amount                  Decimal            @db.Decimal(18, 2)
  currency                String             @default("NGN")
  recipientAccountNumber  String
  recipientBankCode       String
  recipientName           String?
  narration               String?
  status                  BankTransferStatus @default(PENDING)
  failureReason           String?
  workflowInstanceId      String?
  initiatedById           String
  completedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  entity      Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  initiatedBy User   @relation("BankTransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@index([entityId, status])
  @@index([providerCode])
  @@map("bank_transfers")
}

// =====================================================================
// API GATEWAY Ã¢â‚¬â€ Checkpoint A: API Keys (additive)
// =====================================================================
// The inbound counterpart to this codebase's many outbound
// *ProviderRegistry abstractions (Payment/Bank/Contacts/...): those let
// 7F LedgerOS call OUT to external services; ApiKey is how an external
// partner calls INTO 7F LedgerOS without a user JWT session. keyHash
// uses the exact same crypto.createHash('sha256') convention
// AuthService.hashToken() already established for RefreshToken Ã¢â‚¬â€ never
// bcrypt here, deliberately: bcrypt's slowness is a FEATURE for
// passwords (checked once at login) and a LIABILITY for API keys
// (checked on every single request an integration makes).
//
// The plaintext key is generated once, returned once, and never
// retrievable again Ã¢â‚¬â€ only keyPrefix (safe to display in a UI list) and
// keyHash (useless without the plaintext) are ever persisted.
//
// scopes is free-form string[], checked dynamically the same way
// permission strings already are elsewhere in this codebase (see
// RequirePermissions's own doc comment) Ã¢â‚¬â€ no fixed enum/catalog to keep
// in sync.

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id          String       @id @default(uuid())
  entityId    String
  name        String
  keyPrefix   String
  keyHash     String       @unique
  scopes      String[]
  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdById String
  createdAt   DateTime     @default(now())

  // API Gateway, Checkpoint B Ã¢â‚¬â€ Rate Limiting (additive). Nullable,
  // same "absence means the gate doesn't apply" convention expiresAt
  // already uses on this model Ã¢â‚¬â€ null means unlimited (Checkpoint A's
  // existing keys all read as unlimited after this migration, not
  // zero-requests-allowed).
  rateLimitPerMinute Int?

  entity    Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy User?  @relation("ApiKeyRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([entityId, status])
  @@map("api_keys")
}

// =====================================================================
// INVENTORY
// Multiple domains (construction materials, tools & equipment, HSE
// supplies, office supplies, property inventory) sharing one movement
// ledger. Weighted-average valuation is maintained on StockBalance and
// recalculated transactionally by the Inventory service on every
// posted movement.
// =====================================================================

enum InventoryDomain {
  CONSTRUCTION_MATERIALS
  TOOLS_EQUIPMENT
  HSE_SUPPLIES
  OFFICE_SUPPLIES
  PROPERTY_INVENTORY
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_ADJUSTMENT
}

enum InventoryDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Warehouse {
  id       String  @id @default(uuid())
  entityId String
  code     String
  name     String
  isActive Boolean @default(true)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  stockBalances    StockBalance[]
  movements        StockMovement[]
  goodsReceipts    GoodsReceipt[]
  materialIssues   MaterialIssue[]
  stockCounts      StockCount[]
  transfersOut     StockTransfer[] @relation("TransferFromWarehouse")
  transfersIn      StockTransfer[] @relation("TransferToWarehouse")
  procurementGRNs  ProcurementGRN[]

  @@unique([entityId, code])
  @@map("warehouses")
}

model StockItem {
  id            String           @id @default(uuid())
  entityId      String
  code          String
  name          String
  domain        InventoryDomain
  unitOfMeasure String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  balances StockBalance[]
  movements StockMovement[]
  goodsReceiptLines GoodsReceiptLine[]
  materialIssueLines MaterialIssueLine[]
  stockTransferLines StockTransferLine[]
  stockCountLines StockCountLine[]
  purchaseOrderLines PurchaseOrderLine[]
  procurementGRNLines ProcurementGRNLine[]

  @@unique([entityId, code])
  @@map("stock_items")
}

/// Current weighted-average position per item per warehouse.
model StockBalance {
  stockItemId      String
  warehouseId      String
  quantityOnHand   Decimal @db.Decimal(18, 4) @default(0)
  averageUnitCost  Decimal @db.Decimal(18, 4) @default(0)
  totalValue       Decimal @db.Decimal(18, 2) @default(0)
  updatedAt        DateTime @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([stockItemId, warehouseId])
  @@map("stock_balances")
}

/// Append-only ledger of every quantity/value change Ã¢â‚¬â€ the audit trail
/// behind StockBalance's running weighted-average figures.
model StockMovement {
  id            String            @id @default(uuid())
  stockItemId   String
  warehouseId   String
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(18, 4)
  unitCost      Decimal           @db.Decimal(18, 4)
  totalCost     Decimal           @db.Decimal(18, 2)
  movementDate  DateTime
  referenceType String?           // "GoodsReceipt" | "MaterialIssue" | "StockTransfer" | "StockCount"
  referenceId   String?
  createdAt     DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([stockItemId, warehouseId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model GoodsReceipt {
  id              String              @id @default(uuid())
  warehouseId     String
  vendorId        String?
  receiptDate     DateTime
  referenceNumber String?
  status          InventoryDocStatus  @default(DRAFT)
  createdById     String
  createdAt       DateTime            @default(now())

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  vendor    Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines     GoodsReceiptLine[]

  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String  @id @default(uuid())
  goodsReceiptId String
  stockItemId    String
  quantity       Decimal @db.Decimal(18, 4)
  unitCost       Decimal @db.Decimal(18, 4)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_lines")
}

model MaterialIssue {
  id           String             @id @default(uuid())
  warehouseId  String
  projectId    String?
  costCenterId String?
  issueDate    DateTime
  purpose      String?
  status       InventoryDocStatus @default(DRAFT)
  createdById  String
  createdAt    DateTime           @default(now())

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     MaterialIssueLine[]

  @@map("material_issues")
}

model MaterialIssueLine {
  id              String  @id @default(uuid())
  materialIssueId String
  stockItemId     String
  quantity        Decimal @db.Decimal(18, 4)

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Restrict)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@map("material_issue_lines")
}

model StockTransfer {
  id              String             @id @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  transferDate    DateTime
  status          InventoryDocStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime           @default(now())

  fromWarehouse Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id              String  @id @default(uuid())
  stockTransferId String
  stockItemId     String
  quantity        Decimal @db.Decimal(18, 4)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@map("stock_transfer_lines")
}

model StockCount {
  id          String             @id @default(uuid())
  warehouseId String
  countDate   DateTime
  status      InventoryDocStatus @default(DRAFT)
  createdById String
  createdAt   DateTime           @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     StockCountLine[]

  @@map("stock_counts")
}

model StockCountLine {
  id               String  @id @default(uuid())
  stockCountId     String
  stockItemId      String
