  @@index([parentEntityId])
  @@index([childEntityId])
  @@map("entity_relationships")
}

// =====================================================================
// GLOBAL CHART OF ACCOUNTS
// =====================================================================

model Account {
  id            String          @id @default(uuid())
  code          String          @unique // group-wide GL code e.g. "1000-100"
  name          String
  accountType   AccountType
  accountCategory AccountCategory
  ifrsMapping   String?         // e.g. "IAS 1 - Current Assets"
  isControlAccount Boolean      @default(false) // e.g. AR/AP control accounts
  isPostable    Boolean         @default(true)  // false for header/summary accounts

  parentAccountId String?
  parentAccount   Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts   Account[] @relation("AccountHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityActivations EntityAccount[]
  journalLines       JournalLine[]
  budgetLines        BudgetLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  vendorInvoiceLines       VendorInvoiceLine[]
  procurementGRNsAsClearingAccount ProcurementGRN[]
  whtDeductions WHTDeduction[] @relation("WHTTaxAuthorityAccount")
  vatDeductions VATDeduction[] @relation("VATTaxAuthorityAccount")
  arInvoiceLines ARInvoiceLine[]
  reconciliationSessions ReconciliationSession[]

  // Release (Fixed Assets Core, additive)
  assetCategoriesAsAssetAccount            AssetCategory[] @relation("FixedAssetCategoryAssetAccount")
  assetCategoriesAsAccumulatedDeprAccount  AssetCategory[] @relation("FixedAssetCategoryAccDeprAccount")
  assetCategoriesAsDeprExpenseAccount      AssetCategory[] @relation("FixedAssetCategoryDeprExpenseAccount")

  // Release (Tax Center Core, additive)
  taxCodesAsAuthorityAccount TaxCode[] @relation("TaxCodeAuthorityAccount")

  // Release L Ã¢â‚¬â€ Output VAT on AR Invoices (additive)
  arInvoiceLinesAsVatAuthority ARInvoiceLine[] @relation("ARInvoiceLineVatAuthority")

  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculationsAsWhtAuthority CommissionCalculation[] @relation("CommissionCalculationWhtAuthorityAccount")
  // RE-COMM.4 (additive)
  commissionCalculationsAsPayableAccount CommissionCalculation[] @relation("CommissionCalculationPayableAccount")

  @@index([accountType])
  @@index([parentAccountId])
  @@map("accounts")
}

/// Activates a group-chart account for a specific entity (per-entity enable/disable)
model EntityAccount {
  entityId  String
  accountId String
  isActive  Boolean @default(true)

  // CASCADE justified: pure activation flag for an entity/account pairing (chart-of-accounts
  // config), carries no transactional or financial history of its own.
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([entityId, accountId])
  @@map("entity_accounts")
}

// =====================================================================
// DIMENSION ENGINE
// =====================================================================
// Entity is dimension #1 (modeled above). The remaining dimensions below
// are referenced directly on JournalLine as nullable FKs.

model Estate {
  id          String   @id @default(uuid())
  entityId    String
  code        String
  name        String
  description String?
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  entity   Entity    @relation(fields: [entityId], references: [id], onDelete: Restrict)
  projects Project[]
  masterPlans EstateMasterPlan[]
  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive)
  crmLeads     Lead[]
  crmProspects Prospect[]
  // Agent & Commission Management, RE-COMM.1 (additive)
  commissionPlans CommissionPlan[]

  @@unique([entityId, code])
  @@map("estates")
}

model Project {
  id          String   @id @default(uuid())
  entityId    String
  estateId    String?
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  entity Entity  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  estate Estate? @relation(fields: [estateId], references: [id], onDelete: Restrict)
  phases Phase[]
  journalLines JournalLine[]
  budgetLines  BudgetLine[]
  boqs          Boq[]
  workPackages  WorkPackage[]
  incidentReports       IncidentReport[]
  nearMisses            NearMiss[]
  toolboxTalks          ToolboxTalk[]
  inspectionChecklists  InspectionChecklist[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  jobRequisitions       JobRequisition[]
  arInvoiceLines        ARInvoiceLine[]
  userAccess            UserProjectAccess[]
  unitReservations      UnitReservation[]
  plotReleases          PlotProjectRelease[]
  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive)
  crmLeads              Lead[]
  crmProspects          Prospect[]
  // Phase 5A Ã¢â‚¬â€ Facility Management (additive): common-area facilities
  // (generator, lifts, security systems, etc.) serving this project/estate.
  facilities            Facility[]

  // Release H (PMO Scheduling Core, additive)
  tasks                 ProjectTask[]
  // Release I (PMO Risk & Issue Management, additive)
  risks                 ProjectRisk[]
  issues                ProjectIssue[]
  // Release J (PMO Resource & Equipment/Labour Allocation, additive)
  resources             ProjectResource[]
  // Agent & Commission Management, RE-AGENT.2 (additive)
  agentAssignments       AgentAssignment[]
  // Agent & Commission Management, RE-COMM.1 (additive)
  commissionPlans        CommissionPlan[]

  @@unique([entityId, code])
  @@map("projects")
}

model Phase {
  id        String  @id @default(uuid())
  projectId String
  code      String
  name      String
  isActive  Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  blocks  Block[]
  journalLines JournalLine[]
  budgetLines  BudgetLine[]
  boqs          Boq[]
  workPackages  WorkPackage[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  arInvoiceLines           ARInvoiceLine[]

  @@unique([projectId, code])
  @@map("phases")
}

model Block {
  id      String  @id @default(uuid())
  phaseId String
  code    String
  name    String
  isActive Boolean @default(true)

  phase  Phase   @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  floors Floor[]
  journalLines JournalLine[]

  @@unique([phaseId, code])
  @@map("blocks")
}

model Floor {
  id      String @id @default(uuid())
  blockId String
  code    String
  name    String
  isActive Boolean @default(true)

  block Block  @relation(fields: [blockId], references: [id], onDelete: Restrict)
  units Unit[]
  journalLines JournalLine[]

  @@unique([blockId, code])
  @@map("floors")
}

model Unit {
  id           String     @id @default(uuid())
  floorId      String
  code         String     // e.g. "A-3-12"
  name         String?
  unitType     String?    // e.g. "3-Bed Terrace"
  sizeSqm      Decimal?   @db.Decimal(10, 2)
  listPrice    Decimal    @db.Decimal(18, 2)
  status       UnitStatus @default(AVAILABLE)

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Restrict)

  installmentSchedules InstallmentSchedule[]
  journalLines         JournalLine[]
  saleAllocations      UnitSaleAllocation[]
  reservations         UnitReservation[]
  allocationEvents     UnitAllocationEvent[]
  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive)
  prospectInterests    Prospect[]
  // Phase 5A Ã¢â‚¬â€ Handover Workflow / Snag Lists / Defect Tracking (additive)
  handoverRecords      HandoverRecord[]
  snagItems            SnagItem[]
  // Phase 5A Ã¢â‚¬â€ Tenant / Lease Management (additive)
  tenants              Tenant[]
  leases               Lease[]
  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive)
  facilities           Facility[]
  maintenanceRequests  MaintenanceRequest[]
  // Agent & Commission Management, RE-AGENT.2 (additive)
  agentAssignments     AgentAssignment[]
  // Agent & Commission Management, RE-COMM.1 (additive)
  commissionPlans      CommissionPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorId, code])
  @@map("units")
}

/// A raw land holding, pre-development. Parcels move through
/// acquisition -> titling -> survey -> subdivision into Plots. A Plot may
/// later be released into an Estate/Project for construction (that link
/// is deliberately loose Ã¢â‚¬â€ Estate Master Planning, deferred to a later
/// slice, is what formally binds a Plot to a Project).
model LandParcel {
  id                    String           @id @default(uuid())
  entityId              String
  code                  String
  name                  String
  description           String?
  location              String?
  stateProvince         String?
  localGovernmentArea   String?
  areaSqm               Decimal          @db.Decimal(14, 2)
  acquisitionCostBudget Decimal?         @db.Decimal(18, 2)
  status                LandParcelStatus @default(AVAILABLE)
  isActive              Boolean          @default(true)
  createdById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  entity       Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  acquisitions LandAcquisition[]
  titleDeeds   TitleDeed[]
  surveyPlans  SurveyPlan[]
  plots        Plot[]

  @@unique([entityId, code])
  @@map("land_parcels")
}

/// The commercial record of acquiring a LandParcel from a vendor. A
/// parcel may carry more than one acquisition row across its history
/// (e.g. a renegotiation), but only one should reach COMPLETED.
model LandAcquisition {
  id                String                 @id @default(uuid())
  parcelId          String
  vendorName        String
  vendorContact     String?
  agreedPrice       Decimal                @db.Decimal(18, 2)
  currency          String                 @default("NGN")
  paymentTerms      String?
  dueDiligenceNotes String?
  status            LandAcquisitionStatus  @default(NEGOTIATION)
  acquisitionDate   DateTime?
  completedAt       DateTime?
  createdById       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  parcel LandParcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([parcelId, status])
  @@map("land_acquisitions")
}

/// A title/perfection document tracked against a parcel (C of O, deed of
/// assignment, governor's consent, etc.). A parcel typically accrues
/// several of these over its titling lifecycle.
model TitleDeed {
  id                String      @id @default(uuid())
  parcelId          String
  titleType         TitleType
  titleNumber       String?
  status            TitleStatus @default(PENDING)
  issuingAuthority  String?
  applicationDate   DateTime?
  issuedDate        DateTime?
  expiryDate        DateTime?
  documentRef       String?
  notes             String?
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  parcel LandParcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([parcelId, status])
  @@map("title_deeds")
}

/// A survey (beacon/coordinate) plan for a parcel. Once APPROVED it
/// becomes the basis for subdividing the parcel into Plots.
model SurveyPlan {
  id           String           @id @default(uuid())
  parcelId     String
  planNumber   String
  surveyorName String?
  surveyDate   DateTime?
  areaSqm      Decimal?         @db.Decimal(14, 2)
  coordinates  Json?
  documentRef  String?
  status       SurveyPlanStatus @default(DRAFT)
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  parcel LandParcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  plots  Plot[]

  @@unique([parcelId, planNumber])
  @@map("survey_plans")
}

/// An individual subdivided plot within a parcel, per an approved survey
/// plan. Plots are the hand-off point to Estate Master Planning (a later
/// slice), which will formally allocate a Plot to a Project for
/// development.
model Plot {
  id           String      @id @default(uuid())
  parcelId     String
  surveyPlanId String?
  plotNumber   String
  areaSqm      Decimal     @db.Decimal(14, 2)
  useType      PlotUseType @default(RESIDENTIAL)
  status       PlotStatus  @default(PLANNED)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  parcel     LandParcel  @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  surveyPlan SurveyPlan? @relation(fields: [surveyPlanId], references: [id], onDelete: SetNull)
  release    PlotProjectRelease?

  @@unique([parcelId, plotNumber])
  @@map("plots")
}

/// A versioned master plan for an Estate. Only one plan per estate should
/// be APPROVED at a time Ã¢â‚¬â€ approving a new version automatically
/// supersedes the previously-approved one (history is kept, not deleted).
model EstateMasterPlan {
  id                String            @id @default(uuid())
  estateId          String
  version           Int               @default(1)
  status            MasterPlanStatus  @default(DRAFT)
  summary           String?
  totalPlannedUnits Int?
  approvedAt        DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  estate Estate           @relation(fields: [estateId], references: [id], onDelete: Restrict)
  zones  MasterPlanZone[]

  @@unique([estateId, version])
  @@map("estate_master_plans")
}

/// A land-use zone within a master plan (e.g. "Residential Block A"),
/// used to plan out how the estate's plots will ultimately be used.
model MasterPlanZone {
  id               String      @id @default(uuid())
  masterPlanId     String
  code             String
  name             String
  useType          PlotUseType
  plannedAreaSqm   Decimal?    @db.Decimal(14, 2)
  plannedUnitCount Int?
  createdAt        DateTime    @default(now())

  masterPlan EstateMasterPlan @relation(fields: [masterPlanId], references: [id], onDelete: Restrict)

  @@unique([masterPlanId, code])
  @@map("master_plan_zones")
}

/// The formal hand-off of a Plot (Land Bank) into a Project (Real Estate
/// build pipeline) for development. One active release per plot Ã¢â‚¬â€ the
/// unique constraint on plotId enforces that a plot can't be released
/// twice while a release is still active; cancelling a release frees the
/// plot to be released again.
model PlotProjectRelease {
  id           String    @id @default(uuid())
  plotId       String    @unique
  projectId    String
  releaseDate  DateTime  @default(now())
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String?
  createdAt    DateTime  @default(now())

  plot    Plot    @relation(fields: [plotId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("plot_project_releases")
}

model Department {
  id       String  @id @default(uuid())
  entityId String
  code     String
  name     String
  isActive Boolean @default(true)

  entity    Entity     @relation(fields: [entityId], references: [id], onDelete: Restrict)
  employees Employee[]
  journalLines JournalLine[]
  budgetLines  BudgetLine[]
  purchaseRequisitions    PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  jobRequisitions JobRequisition[]
  vacancies       Vacancy[]
  employmentEventsFrom EmploymentEvent[] @relation("EmploymentEventFromDept")
  employmentEventsTo   EmploymentEvent[] @relation("EmploymentEventToDept")
  userAccess UserDepartmentAccess[]
  // Release (Fixed Assets Core, additive)
  fixedAssets FixedAsset[]

  @@unique([entityId, code])
  @@map("departments")
}

model CostCenter {
  id       String  @id @default(uuid())
  entityId String
  code     String
  name     String
  isActive Boolean @default(true)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]
  budgetLines  BudgetLine[]
  purchaseRequisitions    PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  jobRequisitions JobRequisition[]
  userAccess UserCostCenterAccess[]
  // Release (Fixed Assets Core, additive)
  fixedAssets FixedAsset[]

  @@unique([entityId, code])
  @@map("cost_centers")
}

model FundingSource {
  id       String  @id @default(uuid())
  entityId String
  code     String
  name     String
  sourceType String? // e.g. "Equity", "Bank Loan", "Investor Capital"
  isActive Boolean @default(true)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]
  budgetLines  BudgetLine[]
  purchaseRequisitions    PurchaseRequisition[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines      PurchaseOrderLine[]

  @@unique([entityId, code])
  @@map("funding_sources")
}

model Vendor {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  taxId     String?
  bankName  String?
  bankAccountNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalLines JournalLine[]
  contracts    Contractor[]
  goodsReceipts GoodsReceipt[]

  purchaseOrders  PurchaseOrder[]
  procurementGRNs ProcurementGRN[]
  vendorInvoices  VendorInvoice[]
  vendorLedgerEntries VendorLedger[]
  paymentVouchers PaymentVoucher[]

  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive)
  facilitiesServiced   Facility[]
  maintenanceRequests  MaintenanceRequest[] @relation("MaintenanceAssignedVendor")

  @@map("vendors")
}

model Customer {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  journalLines         JournalLine[]
  installmentSchedules InstallmentSchedule[]
  saleAllocations      UnitSaleAllocation[]
  arInvoices           ARInvoice[]
  receipts             Receipt[]
  customerLedgerEntries CustomerLedger[]
  reservations          UnitReservation[]
  allocationEventsFrom  UnitAllocationEvent[] @relation("AllocationEventFromCustomer")
  allocationEventsTo    UnitAllocationEvent[] @relation("AllocationEventToCustomer")
  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive): this customer record was
  // created when a Prospect converted (see Prospect.convertedCustomerId).
  convertedFromProspects Prospect[]
  // Phase 5A Ã¢â‚¬â€ Handover Workflow (additive)
  handoverRecords        HandoverRecord[]
  // Phase 5A Ã¢â‚¬â€ Tenant Management (additive)
  tenancies              Tenant[]

  @@map("customers")
}

// =====================================================================
// FISCAL PERIODS
// =====================================================================

model FiscalPeriod {
  id        String       @id @default(uuid())
  entityId  String
  name      String       // e.g. "2026-07"
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OPEN)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]
  ifrsNoteDisclosures IfrsNoteDisclosure[]

  @@unique([entityId, name])
  @@map("fiscal_periods")
}

// =====================================================================
// GENERAL LEDGER
// =====================================================================

/// Backs atomic, gap-free journal number assignment per entity per year.
/// The posting engine increments `lastNumber` with a locking UPDATE
/// inside the posting transaction so concurrent posts never collide.
model JournalNumberSequence {
  entityId   String
  fiscalYear Int
  lastNumber Int    @default(0)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@id([entityId, fiscalYear])
  @@map("journal_number_sequences")
}

model JournalEntry {
  id             String             @id @default(uuid())
  journalNumber  String             @unique // assigned atomically on posting, e.g. "7FC-JE-2026-000123"
  entityId       String
  fiscalPeriodId String
  entryDate      DateTime
  description    String
  sourceType     JournalSourceType  @default(MANUAL)
  sourceReference String?           // e.g. payroll run id, IC transaction id
  status         JournalEntryStatus @default(DRAFT)

  reversalOfId   String? @unique
  reversalOf     JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     JournalEntry? @relation("Reversal")

  createdById  String
  createdBy    User   @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   User?  @relation("JournalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  postedById   String?
  postedBy     User?  @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: Restrict)

  approvedAt DateTime?
  postedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity       Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  fiscalPeriod FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  intercompanyTransaction IntercompanyTransaction?
  vendorLedgerEntries     VendorLedger[]
  customerLedgerEntries   CustomerLedger[]

  // Release (Fixed Assets Core, additive)
  depreciationEntries DepreciationEntry[]
  assetDisposals      AssetDisposal[]

  // Agent & Commission Management, RE-COMM.4 (additive)
  commissionPayableEntries CommissionCalculation[] @relation("CommissionCalculationPayableJournalEntry")
  commissionPaymentEntries CommissionCalculation[] @relation("CommissionCalculationPaymentJournalEntry")

  @@index([entityId, status])
  @@index([fiscalPeriodId])
  @@index([sourceType, sourceReference])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String
  lineNumber     Int

  accountId String

  debit  Decimal @db.Decimal(18, 2) @default(0)
  credit Decimal @db.Decimal(18, 2) @default(0)

  memo String?

  // ---- Dimensions ----
  entityId        String
  projectId       String?
  phaseId         String?
  blockId         String?
  floorId         String?
  unitId          String?
  departmentId    String?
  costCenterId    String?
  fundingSourceId String?
  vendorId        String?
  customerId      String?

  createdAt DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase         Phase?         @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  block         Block?         @relation(fields: [blockId], references: [id], onDelete: Restrict)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: Restrict)
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  fundingSource FundingSource? @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([entityId])
  @@index([projectId])
  @@index([unitId])
  @@index([vendorId])
  @@index([customerId])
  @@map("journal_lines")
}

// =====================================================================
// AUDIT TRAIL
// =====================================================================

/// Phase 3C Ã¢â‚¬â€ IFRS narrative note disclosures. Seven of the twenty-five
/// notes requested (Reporting Entity Info, Basis of Preparation,
/// Significant Accounting Policies, Related Party Transactions,
/// Commitments, Contingent Liabilities, Subsequent Events) are not
/// mechanically derivable from journal postings Ã¢â‚¬â€ a contingent liability,
/// by definition, has NOT been recognized in the ledger, so there is no
/// account balance to summarize. IFRS requires these as preparer-entered
/// narrative disclosures. This model stores exactly that: one row per
/// (entity, fiscal period, note type), editable by whoever has
/// gl.journal.post authority (reusing that permission rather than adding a
/// new one Ã¢â‚¬â€ see ReportingController), surfaced by ifrsNotes() alongside
/// the eighteen GL-derived notes so the API returns one coherent document.
model IfrsNoteDisclosure {
  id             String              @id @default(uuid())
  entityId       String
  fiscalPeriodId String
  noteType       IfrsNarrativeNoteType
  content        String
  updatedById    String
  updatedAt      DateTime            @updatedAt
  createdAt      DateTime            @default(now())

  entity       Entity       @relation(fields: [entityId], references: [id])
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  updatedBy    User         @relation(fields: [updatedById], references: [id])

  @@unique([entityId, fiscalPeriodId, noteType])
  @@index([entityId, fiscalPeriodId])
  @@map("ifrs_note_disclosures")
}

enum IfrsNarrativeNoteType {
  REPORTING_ENTITY_INFORMATION
  BASIS_OF_PREPARATION
  SIGNIFICANT_ACCOUNTING_POLICIES
  RELATED_PARTY_TRANSACTIONS
  COMMITMENTS
  CONTINGENT_LIABILITIES
  SUBSEQUENT_EVENTS
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "JOURNAL_POSTED", "PERIOD_LOCKED"
  entityType String   // e.g. "JournalEntry"
  entityId   String   // record id affected
  beforeState Json?
  afterState  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// =====================================================================
// INTERCOMPANY ENGINE
// =====================================================================

model IntercompanyTransaction {
  id                 String               @id @default(uuid())
  initiatorEntityId  String
  counterpartyEntityId String
  journalEntryId     String               @unique
  mirrorJournalEntryId String?            @unique
  amount             Decimal              @db.Decimal(18, 2)
  currency           String               @default("NGN")
  description        String
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiatorEntity    Entity       @relation("ICInitiatorEntity", fields: [initiatorEntityId], references: [id], onDelete: Restrict)
  counterpartyEntity Entity       @relation("ICCounterpartyEntity", fields: [counterpartyEntityId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  eliminations IntercompanyElimination[]

  @@index([initiatorEntityId])
  @@index([counterpartyEntityId])
  @@map("intercompany_transactions")
}

model IntercompanyElimination {
  id                        String   @id @default(uuid())
  intercompanyTransactionId String
  consolidationGroupId      String
  eliminationAmount         Decimal  @db.Decimal(18, 2)
  fiscalPeriodId             String
  createdAt                 DateTime @default(now())

  intercompanyTransaction IntercompanyTransaction @relation(fields: [intercompanyTransactionId], references: [id], onDelete: Restrict)
  consolidationGroup      ConsolidationGroup      @relation(fields: [consolidationGroupId], references: [id], onDelete: Restrict)

  @@map("intercompany_eliminations")
}

// =====================================================================
// CONSOLIDATION ENGINE
// =====================================================================

model ConsolidationGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  parentEntityId String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  ownerships   ConsolidationOwnership[]
  eliminations IntercompanyElimination[]

  @@map("consolidation_groups")
}

model ConsolidationOwnership {
  id                   String   @id @default(uuid())
  consolidationGroupId String
  parentEntityId       String
  childEntityId        String
  ownershipPercent     Decimal  @db.Decimal(6, 3)
  effectiveFrom        DateTime
  effectiveTo          DateTime?

  consolidationGroup ConsolidationGroup @relation(fields: [consolidationGroupId], references: [id], onDelete: Restrict)
  parentEntity       Entity             @relation("OwnershipParent", fields: [parentEntityId], references: [id], onDelete: Restrict)
  childEntity        Entity             @relation("OwnershipChild", fields: [childEntityId], references: [id], onDelete: Restrict)

  @@index([consolidationGroupId])
  @@map("consolidation_ownerships")
}

// =====================================================================
// REAL ESTATE Ã¢â‚¬â€ SALES / REVENUE RECOGNITION
// =====================================================================

model UnitSaleAllocation {
  id         String   @id @default(uuid())
  unitId     String
  customerId String
  salePrice  Decimal  @db.Decimal(18, 2)
  allocationDate DateTime
  status     UnitStatus @default(RESERVED)

  // Phase 4 Ã¢â‚¬â€ Property Sales completion (additive). The existing `status`
  // field tracks physical unit lifecycle (RESERVED/ALLOCATED/.../SOLD) and
  // is left untouched; cancellation is modeled separately here rather than
  // overloading `status`, since UnitStatus has no CANCELLED value and this
  // avoids changing the meaning of an existing, working field.
  isCancelled     Boolean   @default(false)
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledById   String?
  // Lineage for transfer/swap: the allocation this one replaced, if any.
  // Cancelling the old allocation and creating a new one (rather than
  // mutating customerId in place) keeps full history instead of losing it.
  transferredFromAllocationId String? @unique

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cancelledBy        User?               @relation("AllocationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  transferredFrom     UnitSaleAllocation? @relation("AllocationTransferLineage", fields: [transferredFromAllocationId], references: [id], onDelete: Restrict)
  transferredTo       UnitSaleAllocation? @relation("AllocationTransferLineage")

  installmentSchedule InstallmentSchedule?
  arInvoices          ARInvoice[]
  sourceReservation   UnitReservation?      @relation("ReservationConvertedAllocation")
  events              UnitAllocationEvent[]
  // Phase 5A Ã¢â‚¬â€ Mortgage Management / Handover Workflow (additive)
  mortgageApplications MortgageApplication[]
  handoverRecord       HandoverRecord?
  // Agent & Commission Management, RE-AGENT.2 (additive)
  agentAssignments     AgentAssignment[]
  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculations CommissionCalculation[]

  createdAt DateTime @default(now())

  @@map("unit_sale_allocations")
}

// =====================================================================
// PHASE 4 Ã¢â‚¬â€ REAL ESTATE: PROPERTY SALES COMPLETION (additive)
// =====================================================================

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

enum AllocationEventType {
  RESERVED
  RESERVATION_EXPIRED
  RESERVATION_CANCELLED
  CONVERTED_TO_SALE
  SALE_CANCELLED
  TRANSFERRED
  SWAPPED
  RESOLD
}

/// A hold on a unit before a confirmed sale. Separate from
/// UnitSaleAllocation (which represents the confirmed sale/installment
/// plan) so an expired or cancelled reservation never needs to touch
/// financial records Ã¢â‚¬â€ nothing is posted to GL until conversion.
model UnitReservation {
  id             String            @id @default(uuid())
  unitId         String
  customerId     String
  // Denormalized (not derived via unit->floor->block->phase->project) for
  // efficient RLS filtering and reporting, matching the existing pattern
  // already used by ARInvoiceLine.projectId/phaseId elsewhere in this schema.
  entityId       String
  projectId      String
  reservationFee Decimal?          @db.Decimal(18, 2)
  reservedAt     DateTime          @default(now())
  expiresAt      DateTime
  status         ReservationStatus @default(ACTIVE)
  cancelledReason String?
  cancelledById   String?
  // True when this reservation is for a unit with a prior cancelled
  // allocation (i.e. this is a resale, not the unit's first sale).
  isResale               Boolean @default(false)
  convertedAllocationId  String? @unique
  createdById            String
  createdAt              DateTime @default(now())

  unit                Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  entity              Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  cancelledBy         User?               @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdBy           User                @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  convertedAllocation UnitSaleAllocation? @relation("ReservationConvertedAllocation", fields: [convertedAllocationId], references: [id], onDelete: Restrict)
  events              UnitAllocationEvent[]

  @@index([unitId, status])
  @@index([status, expiresAt])
  @@map("unit_reservations")
}

/// Append-only audit trail for everything that happens to a unit's
/// sale/reservation lifecycle Ã¢â‚¬â€ Restrict, matching the schema's audit-log
/// deletion policy, so this history can never be silently lost as a side
/// effect of deleting something else.
model UnitAllocationEvent {
  id             String              @id @default(uuid())
  unitId         String
  allocationId   String?
  reservationId  String?
  eventType      AllocationEventType
  fromCustomerId String?
  toCustomerId   String?
  notes          String?
  createdById    String
  createdAt      DateTime            @default(now())

  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  allocation   UnitSaleAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  reservation  UnitReservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  fromCustomer Customer?           @relation("AllocationEventFromCustomer", fields: [fromCustomerId], references: [id], onDelete: Restrict)
  toCustomer   Customer?           @relation("AllocationEventToCustomer", fields: [toCustomerId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("AllocationEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([unitId, createdAt])
  @@index([allocationId])
  @@map("unit_allocation_events")
}

model InstallmentSchedule {
  id           String   @id @default(uuid())
  unitId       String
  customerId   String
  allocationId String   @unique
  totalAmount  Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  unit       Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocation UnitSaleAllocation   @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  lines      InstallmentLine[]

  @@map("installment_schedules")
}

model InstallmentLine {
  id           String    @id @default(uuid())
  scheduleId   String
  dueDate      DateTime
  amountDue    Decimal   @db.Decimal(18, 2)
  amountPaid   Decimal   @db.Decimal(18, 2) @default(0)
  paidAt       DateTime?

  schedule InstallmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@map("installment_lines")
}

// =====================================================================
// PHASE 5A Ã¢â‚¬â€ REAL ESTATE: CRM / LEAD MANAGEMENT / PROSPECTS (additive)
// =====================================================================
// Pipeline is Lead -> (qualify) -> Prospect -> (reserve) -> UnitReservation
// (Phase 4, unchanged) -> UnitSaleAllocation (Phase 4, unchanged). This
// section only adds the pre-sale CRM stages; it deliberately calls back
// into the existing RealEstateService for reservation/allocation rather
// than re-implementing any of that logic here.

enum LeadSource {
  WALK_IN
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  PROPERTY_PORTAL
  AGENT
  EVENT
  COLD_CALL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum ProspectStatus {
  ACTIVE
  SITE_VISIT_SCHEDULED
  SITE_VISIT_DONE
  NEGOTIATING
  RESERVED
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  WHATSAPP
  SMS
  NOTE
  FOLLOW_UP
}

/// A raw enquiry, before it's been qualified as a genuine buyer. Leads are
/// intentionally lightweight and carry no financial data Ã¢â‚¬â€ nothing here
/// posts to GL. Converts 1:1 into a Prospect (see Prospect.leadId).
model Lead {
  id                 String     @id @default(uuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  source             LeadSource @default(OTHER)
  status             LeadStatus @default(NEW)
  entityId           String
  projectId          String?
  estateId           String?
  budgetMin          Decimal?   @db.Decimal(18, 2)
  budgetMax          Decimal?   @db.Decimal(18, 2)
  notes              String?
  assignedToId       String?
  disqualifiedReason String?
  convertedAt        DateTime?
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  estate     Estate?  @relation(fields: [estateId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy  User     @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  activities CrmActivity[]
  prospect   Prospect?

  @@index([entityId, status])
  @@index([assignedToId])
  @@map("crm_leads")
}

/// A qualified buyer being actively worked toward a reservation. May
/// originate from a converted Lead (leadId set) or be opened directly
/// (e.g. a repeat buyer who already has a Customer record). Reserving a
/// unit for a Prospect reuses RealEstateService.reserveUnit() as-is Ã¢â‚¬â€
/// this model only tracks the CRM side (assignment, site visits,
/// negotiation) up to the point a Customer/UnitReservation exists.
model Prospect {
  id                 String         @id @default(uuid())
  leadId             String?        @unique
  entityId           String
  projectId          String?
  estateId           String?
  unitOfInterestId   String?
  status             ProspectStatus @default(ACTIVE)
  assignedToId       String?
  budgetMin          Decimal?       @db.Decimal(18, 2)
  budgetMax          Decimal?       @db.Decimal(18, 2)
  expectedCloseDate  DateTime?
  lostReason         String?
  wonAt              DateTime?
  // Set once this prospect has a Customer record (created on first
  // reservation, or pre-existing for a repeat buyer). Nullable because a
  // brand-new prospect has no Customer until they actually reserve.
  convertedCustomerId String?       @unique
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  entity            Entity    @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  estate            Estate?   @relation(fields: [estateId], references: [id], onDelete: Restrict)
  unitOfInterest    Unit?     @relation(fields: [unitOfInterestId], references: [id], onDelete: Restrict)
  assignedTo        User?     @relation("ProspectAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  convertedCustomer Customer? @relation(fields: [convertedCustomerId], references: [id], onDelete: Restrict)
  createdBy         User      @relation("ProspectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  activities CrmActivity[]

  @@index([entityId, status])
  @@index([assignedToId])
  @@map("crm_prospects")
}

/// Append-only interaction log shared by Lead and Prospect (exactly one
/// of leadId/prospectId is set) Ã¢â‚¬â€ one activity model rather than two
/// near-identical ones, per the "never duplicate logic" rule.
model CrmActivity {
  id           String          @id @default(uuid())
  leadId       String?
  prospectId   String?
  activityType CrmActivityType
  notes        String?
  occurredAt   DateTime        @default(now())
  followUpAt   DateTime?
  createdById  String
  createdAt    DateTime        @default(now())

  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  prospect  Prospect? @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  createdBy User      @relation("CrmActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([prospectId])
  @@index([followUpAt])
  @@map("crm_activities")
}

// =====================================================================
// PHASE 5A Ã¢â‚¬â€ REAL ESTATE: MORTGAGE MANAGEMENT (additive)
// =====================================================================
// Tracks a buyer's external bank/mortgage financing for a unit purchase.
// Disbursement is recorded as an ordinary customer payment via the
// existing RevenueRecognitionService.recordCustomerPayment() (Phase 4,
// unchanged) Ã¢â‚¬â€ the lender's funds are economically just another source
// of cash against the same installment schedule, so no separate posting
// logic is created here.

enum MortgageStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
  DISBURSED
  CLOSED
}

model MortgageApplication {
  id                  String         @id @default(uuid())
  allocationId        String
  entityId            String
  lenderName          String
  amountApplied       Decimal        @db.Decimal(18, 2)
  amountApproved      Decimal?       @db.Decimal(18, 2)
  interestRatePercent Decimal?       @db.Decimal(6, 3)
  tenorMonths         Int?
  status              MortgageStatus @default(DRAFT)
  applicationDate     DateTime       @default(now())
  approvalDate        DateTime?
  declineReason       String?
  disbursementDate    DateTime?
  disbursedAmount     Decimal?       @db.Decimal(18, 2)
  notes               String?
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  allocation UnitSaleAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  entity     Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy  User               @relation("MortgageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([allocationId])
  @@index([entityId, status])
  @@map("mortgage_applications")
}

// =====================================================================
// PHASE 5A Ã¢â‚¬â€ REAL ESTATE: HANDOVER WORKFLOW / SNAG LISTS / DEFECT TRACKING
// (additive)
// =====================================================================
// The operational walkthrough-and-keys process around a sale, separate
// from (and calling into) the existing RevenueRecognitionService, which
// already owns the GL entry + Unit/Allocation status flip to HANDED_OVER.
// One SnagItem model covers both the handover-day punch list and any
// defect reported later during the defects-liability period Ã¢â‚¬â€ same
// shape, only `source` differs Ã¢â‚¬â€ rather than two near-identical tables.

enum HandoverStatus {
  SCHEDULED
  INSPECTION_DONE
  SNAGS_PENDING
  COMPLETED
  CANCELLED
}

enum SnagSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
  REJECTED
}

enum SnagSource {
  HANDOVER_INSPECTION
  POST_HANDOVER_REPORT
}

model HandoverRecord {
  id                String         @id @default(uuid())
  allocationId      String         @unique
  entityId          String
  unitId            String
  customerId        String
  status            HandoverStatus @default(SCHEDULED)
  scheduledDate     DateTime
  inspectedAt       DateTime?
  completedAt       DateTime?
  customerSignedAt  DateTime?
  handedOverById    String?
  cancelledReason   String?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  allocation   UnitSaleAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  entity       Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  unit         Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  handedOverBy User?              @relation("HandoverHandedOverBy", fields: [handedOverById], references: [id], onDelete: Restrict)
  createdBy    User               @relation("HandoverCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  snags SnagItem[]

  @@index([status])
  @@index([entityId])
  @@map("handover_records")
}

model SnagItem {
  id               String       @id @default(uuid())
  handoverRecordId String
  unitId           String
  category         String?
  description      String
  severity         SnagSeverity @default(MINOR)
  status           SnagStatus   @default(OPEN)
  source           SnagSource   @default(HANDOVER_INSPECTION)
  reportedById     String
  assignedToId     String?
  dueDate          DateTime?
  resolvedAt       DateTime?
  resolvedNotes    String?
  verifiedAt       DateTime?
  verifiedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  handoverRecord HandoverRecord @relation(fields: [handoverRecordId], references: [id], onDelete: Restrict)
  unit           Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reportedBy     User           @relation("SnagReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo     User?          @relation("SnagAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  verifiedBy     User?          @relation("SnagVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([handoverRecordId])
  @@index([unitId, status])
  @@map("snag_items")
}

// =====================================================================
// PHASE 5A Ã¢â‚¬â€ REAL ESTATE: TENANT / LEASE MANAGEMENT (additive)
// =====================================================================
// A Tenant is an existing Customer occupying a Unit Ã¢â‚¬â€ it does not
// duplicate person/company data, only the occupancy fact. A Lease is the
// contract governing one Tenant/Unit pairing; only one ACTIVE lease (and
// one ACTIVE tenancy) is allowed per unit at a time, enforced in
// LeaseService rather than the schema (Prisma has no partial-unique
// constraint here). Rent billing does not invent posting logic: each
// LeaseRentInvoice is backed 1:1 by an ARInvoice created and posted
// through the existing AccountsReceivableService (createInvoice /
// postInvoice) Ã¢â‚¬â€ the same service ARInvoice/Receipt already uses for
// unit sales Ã¢â‚¬â€ with allocationId simply left null, since ARInvoice
// already supports non-sale invoices for exactly this reason.

enum TenantStatus {
  ACTIVE
  FORMER
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum LeaseRentFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model Tenant {
  id           String       @id @default(uuid())
  entityId     String
  customerId   String
  unitId       String
  status       TenantStatus @default(ACTIVE)
  moveInDate   DateTime
  moveOutDate  DateTime?
  notes        String?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy User     @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  leases Lease[]
  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive)
  maintenanceRequests MaintenanceRequest[]

  @@index([entityId, status])
  @@index([unitId, status])
  @@index([customerId])
  @@map("tenants")
}

/// The contract governing one Tenant's occupancy of one Unit.
model Lease {
  id                String             @id @default(uuid())
  entityId          String
  tenantId          String
  unitId            String
  leaseNumber       String
  startDate         DateTime
  endDate           DateTime
  rentAmount        Decimal            @db.Decimal(18, 2)
  rentFrequency     LeaseRentFrequency @default(MONTHLY)
  depositAmount     Decimal?           @db.Decimal(18, 2)
  status            LeaseStatus        @default(DRAFT)
  terminatedAt      DateTime?
  terminationReason String?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

