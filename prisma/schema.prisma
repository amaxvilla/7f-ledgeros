  @@map("exit_clearance_items")
}

// ===========================================================================
// RECRUITMENT & APPLICANT TRACKING (ATS) Ã¢â‚¬â€ HR Phase B, module 1
// ===========================================================================

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ON_HOLD
  CLOSED
}

enum VacancyStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model JobRequisition {
  id             String            @id @default(uuid())
  entityId       String
  departmentId   String?
  costCenterId   String?
  projectId      String?
  requestedById  String
  jobTitle       String
  gradeLevel     String?
  employmentType EmploymentType    @default(FULL_TIME)
  headcount      Int               @default(1)
  justification  String?
  budgetLineId   String? // optional link into Budgeting for headcount-cost validation
  status         RequisitionStatus @default(DRAFT)
  workflowInstanceId String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter  CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  budgetLine  BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  requestedBy User        @relation("RequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  vacancies   Vacancy[]

  @@index([entityId, status])
  @@map("job_requisitions")
}

model Vacancy {
  id               String        @id @default(uuid())
  jobRequisitionId String
  entityId         String
  departmentId     String?
  title            String
  description      String?
  location         String?
  employmentType   EmploymentType @default(FULL_TIME)
  status           VacancyStatus @default(DRAFT)
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  jobRequisition JobRequisition   @relation(fields: [jobRequisitionId], references: [id], onDelete: Restrict)
  entity         Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  applications   JobApplication[]

  @@index([entityId, status])
  @@map("vacancies")
}

model Candidate {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  source       String?
  linkedinUrl  String?
  portalUserId String?   @unique
  createdAt    DateTime  @default(now())

  // Release IG.1, Checkpoint G Ã¢â‚¬â€ Outlook contact sync (best-effort, same
  // shape as Interview's calendarProviderCode/calendarEventId/
  // calendarSyncFailedAt trio from Checkpoints C/D). Null until the first
  // successful ContactsProvider.createContact() call; never required for
  // the candidate row itself to exist.
  contactProviderCode String?
  providerContactId   String?
  contactSyncFailedAt DateTime?

  applications JobApplication[]
  documents    CandidateDocument[]

  @@unique([email])
  @@map("candidates")
}

model CandidateDocument {
  id           String   @id @default(uuid())
  candidateId  String
  documentType String // RESUME, COVER_LETTER, CERTIFICATE, ID, OTHER
  fileUrl      String
  fileName     String?
  uploadedAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@map("candidate_documents")
}

model JobApplication {
  id            String           @id @default(uuid())
  vacancyId     String
  candidateId   String
  stage         ApplicationStage @default(APPLIED)
  score         Decimal?         @db.Decimal(5, 2)
  rejectionReason String?
  hiredEmployeeId String?        @unique
  appliedAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  vacancy       Vacancy    @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  hiredEmployee Employee?  @relation(fields: [hiredEmployeeId], references: [id], onDelete: Restrict)
  interviews    Interview[]
  offer         Offer?
  backgroundCheck BackgroundCheck?

  @@unique([vacancyId, candidateId])
  @@index([vacancyId, stage])
  @@map("job_applications")
}

model Interview {
  id              String           @id @default(uuid())
  jobApplicationId String
  round           Int              @default(1)
  title           String
  scheduledAt     DateTime
  durationMinutes Int              @default(60)
  location        String? // physical or "video-call"
  status          InterviewStatus  @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  // Release IG.1, Checkpoint C Ã¢â‚¬â€ calendar sync. Both null until the first
  // successful CalendarProvider.createEvent() call (best-effort; scheduling
  // an interview must never fail because a Graph API call failed Ã¢â‚¬â€ see
  // InterviewService.schedule()'s own comment). providerCode is stored
  // alongside the id (not assumed to always be MS_GRAPH) so a future
  // IG.2 Google Workspace provider can update/cancel an event it created
  // without InterviewService having to guess which provider owns it.
  calendarProviderCode String?
  calendarEventId      String?
  // Release IG.1, Checkpoint D Ã¢â‚¬â€ visibility for calendar-sync failures.
  // Set whenever a best-effort create/update/cancel call to the calendar
  // provider throws (see InterviewService's own comments on each call
  // site); cleared back to null on the next successful create/update
  // sync. Deliberately NOT cleared by a successful cancel Ã¢â‚¬â€ if a prior
  // cancelEvent failed, the flag should stay set until a human confirms
  // the stale calendar entry was dealt with, not silently disappear the
  // next time someone cancels an already-cancelled interview.
  calendarSyncFailedAt DateTime?
  // Release IG.1, Checkpoint S Ã¢â‚¬â€ Teams online-meeting sync for
  // location === "video-call" interviews only (the exact string the
  // location field's own comment above names). Same shape as the
  // calendar fields above: providerCode stored alongside the id so a
  // future IH Google Meet provider can address a meeting it created
  // without guessing; both null when the interview isn't a video call,
  // when no TeamsProvider is registered, or when the best-effort create
  // failed (see InterviewService.trySyncTeamsMeeting's own comment Ã¢â‚¬â€
  // deliberately no separate teamsSyncFailedAt flag yet, unlike
  // calendarSyncFailedAt; a warning is logged instead. That visibility
  // gap plus a retry endpoint are left for a later checkpoint).
  teamsProviderCode String?
  teamsMeetingId    String?
  teamsJoinUrl      String?
  // Release IG.1, Checkpoint T Ã¢â‚¬â€ visibility for Teams-sync failures,
  // closing the gap Checkpoint S's own comment above named. Same shape
  // as calendarSyncFailedAt: set whenever a best-effort createMeeting/
  // cancelMeeting call to the Teams provider throws (see
  // InterviewService.trySyncTeamsMeeting/cancel's own comments), cleared
  // back to null on the next successful create/retry. Deliberately NOT
  // an update-failure case Ã¢â‚¬â€ TeamsProvider has no updateMeeting method
  // (see teams-provider.interface.ts), so reschedule() never touches
  // Teams at all and can't set this flag.
  teamsSyncFailedAt DateTime?

  jobApplication JobApplication      @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  interviewers   InterviewPanelist[]
  feedback       InterviewFeedback[]

  @@index([jobApplicationId])
  @@map("interviews")
}

model InterviewPanelist {
  id          String   @id @default(uuid())
  interviewId String
  employeeId  String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([interviewId, employeeId])
  @@map("interview_panelists")
}

model InterviewFeedback {
  id              String                  @id @default(uuid())
  interviewId     String
  employeeId      String
  rating          Int // 1-5
  recommendation  InterviewRecommendation
  strengths       String?
  concerns        String?
  comments        String?
  submittedAt     DateTime                @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([interviewId, employeeId])
  @@map("interview_feedback")
}

model Offer {
  id                String      @id @default(uuid())
  jobApplicationId  String      @unique
  jobTitle          String
  gradeLevel        String?
  proposedSalary    Decimal     @db.Decimal(18, 2)
  currency          String      @default("NGN")
  startDate         DateTime?
  status            OfferStatus @default(DRAFT)
  workflowInstanceId String?
  letterUrl         String?
  sentAt            DateTime?
  respondedAt       DateTime?
  declineReason     String?
  createdById       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  // Digital Signature Providers Ã¢â‚¬â€ first real caller. signatureProviderEnvelopeId
  // stays null until the first successful SignatureProvider.sendForSignature()
  // call (best-effort; sending an offer must never fail because the
  // DocuSign API call failed Ã¢â‚¬â€ see OfferService.send()'s own comment).
  // signatureProviderCode itself is set earlier, at offer creation
  // (OfferService.create(), Checkpoint M) Ã¢â‚¬â€ caller-chosen via
  // CreateOfferDto.signatureProviderCode, or DOCUSIGN_PROVIDER_CODE by
  // default Ã¢â‚¬â€ so OfferService.send()/retrySignatureSync() both know
  // which provider to target without a dto at that later call site, the
  // same "recorded up front, not only on success" shift
  // ApiKey.rateLimitPerMinute's own null-means-unlimited convention
  // already established a precedent for reusing a nullable column
  // across a broadened lifecycle. Still nullable only for rows created
  // before Checkpoint M shipped.
  signatureProviderCode       String?
  signatureProviderEnvelopeId String?
  // Visibility for signature-sync failures. Same semantics as
  // Interview.calendarSyncFailedAt / Candidate.contactsSyncFailedAt: set
  // whenever a best-effort sendForSignature call throws, cleared back to
  // null on the next successful send. There is no "update" concept to
  // clear it on later (see SignatureProvider's own doc comment Ã¢â‚¬â€ no
  // updateEnvelope exists), only future successful sends of a NEW offer.
  signatureSyncFailedAt DateTime?

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("offers")
}

// Digital Signature Providers, Checkpoint H Ã¢â‚¬â€ backing store for
// GenericSignatureProvider (signatures/providers/generic-signature.provider.ts).
// Unlike DocuSign/Adobe Sign, this provider has no external vendor to be
// the system of record for envelope state, so it needs to be one
// itself Ã¢â‚¬â€ see that provider's own doc comment for the full reasoning.
// status mirrors the SignatureStatus TS union exactly (signature-provider.interface.ts).
model ManualSignatureEnvelope {
  id                  String                @id @default(uuid())
  documentName        String
  documentContentType String
  documentKey         String
  signedDocumentKey   String?
  signersJson         Json
  subject             String?
  message             String?
  status              ManualSignatureStatus @default(SENT)
  voidReason          String?
  // Digital Signature Providers, Checkpoint J Ã¢â‚¬â€ set only via
  // ManualSignatureService.recordDecline. Deliberately separate from
  // voidReason: a decline is the signer's own act (they refused to
  // sign), a void is an HR/ops act (the offer was withdrawn) Ã¢â‚¬â€ same
  // distinction SignatureStatus itself already draws between DECLINED
  // and VOIDED as two different terminal states, not one.
  declineReason       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("manual_signature_envelopes")
}

enum ManualSignatureStatus {
  SENT
  DELIVERED
  COMPLETED
  DECLINED
  VOIDED
}

// ---- Background Checks (Recruitment) ----
// Ported from ZIP A's recruitment implementation onto the canonical
// JobApplication/Candidate model used by the dedicated recruitment module.

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  CLEARED
  FLAGGED
}

model BackgroundCheck {
  id              String                @id @default(uuid())
  jobApplicationId String               @unique
  checkType       String // e.g. "Criminal Record", "Reference Check", "Medical Clearance"
  status          BackgroundCheckStatus @default(PENDING)
  initiatedById   String?
  completedAt     DateTime?
  notes           String?

  createdAt DateTime @default(now())

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Restrict)
  initiatedBy    User?          @relation(fields: [initiatedById], references: [id], onDelete: Restrict)

  @@map("background_checks")
}
enum EmploymentEventType {
  TRANSFER
  PROMOTION
  DEMOTION
  SECONDMENT
  CONTRACT_RENEWAL
  CONFIRMATION
}

model EmploymentEvent {
  id               String              @id @default(uuid())
  employeeId       String
  eventType        EmploymentEventType
  effectiveDate    DateTime
  fromDepartmentId String?
  toDepartmentId   String?
  fromJobTitle     String?
  toJobTitle       String?
  fromGradeLevel   String?
  toGradeLevel     String?
  notes            String?
  initiatedById    String

  createdAt DateTime @default(now())

  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromDepartment Department? @relation("EmploymentEventFromDept", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartment   Department? @relation("EmploymentEventToDept", fields: [toDepartmentId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate])
  @@map("employment_events")
}

// ---- Performance Management ----

enum PerformanceCycleStatus {
  OPEN
  CALIBRATION
  CLOSED
}

model PerformanceCycle {
  id        String                  @id @default(uuid())
  entityId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    PerformanceCycleStatus  @default(OPEN)

  entity  Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  goals   Goal[]
  kpis    Kpi[]
  reviews PerformanceReview[]
  competencyAssessments CompetencyAssessment[]

  @@unique([entityId, name])
  @@map("performance_cycles")
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}

model Goal {
  id              String     @id @default(uuid())
  employeeId      String
  cycleId         String?
  title           String
  description     String?
  weight          Decimal?   @db.Decimal(5, 2) // % weighting toward overall rating (OKR-style)
  targetDate      DateTime?
  status          GoalStatus @default(NOT_STARTED)
  progressPercent Int        @default(0)

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle    PerformanceCycle?  @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("goals")
}

model Kpi {
  id          String   @id @default(uuid())
  employeeId  String
  cycleId     String?
  name        String
  targetValue Decimal  @db.Decimal(18, 4)
  actualValue Decimal  @db.Decimal(18, 4) @default(0)
  unit        String?
  weight      Decimal  @db.Decimal(5, 2) @default(0)

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle    PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("kpis")
}

model Competency {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  assessments CompetencyAssessment[]

  @@map("competencies")
}

model CompetencyAssessment {
  id           String  @id @default(uuid())
  employeeId   String
  competencyId String
  cycleId      String?
  rating       Int // 1-5
  assessedById String
  comments     String?

  createdAt DateTime @default(now())

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  competency Competency        @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  cycle      PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("competency_assessments")
}

enum ReviewStatus {
  DRAFT
  SELF_ASSESSMENT
  MANAGER_REVIEW
  PEER_REVIEW
  CALIBRATED
  COMPLETED
}

/// One review per employee per cycle. Self/manager/peer commentary and
/// the calibrated final rating all live on this single row Ã¢â‚¬â€ simpler to
/// query than a normalized multi-reviewer table, and 360 feedback is
/// still representable via peerComments (free text, multiple reviewers'
/// input consolidated by whoever runs calibration).
model PerformanceReview {
  id              String       @id @default(uuid())
  employeeId      String
  cycleId         String
  reviewerId      String // the employee's manager
  selfRating      Decimal?     @db.Decimal(4, 2)
  selfComments    String?
  managerRating    Decimal?    @db.Decimal(4, 2)
  managerComments  String?
  peerComments     String?
  calibratedRating Decimal?    @db.Decimal(4, 2)
  status          ReviewStatus @default(DRAFT)
  promotionRecommended    Boolean @default(false)
  incrementRecommended    Decimal? @db.Decimal(5, 2) // recommended % salary increment
  bonusRecommended        Decimal? @db.Decimal(18, 2)
  pipRequired             Boolean @default(false) // Performance Improvement Plan flag
  completedAt     DateTime?

  createdAt DateTime @default(now())

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle    PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, cycleId])
  @@map("performance_reviews")
}

// ---- Training & Learning ----

model TrainingCourse {
  id            String   @id @default(uuid())
  entityId      String
  code          String
  name          String
  description   String?
  durationHours Decimal? @db.Decimal(6, 2)
  provider      String? // internal or external provider name
  isExternal    Boolean  @default(false)
  cost          Decimal? @db.Decimal(18, 2)
  isActive      Boolean  @default(true)

  entity   Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  sessions TrainingSession[]

  @@unique([entityId, code])
  @@map("training_courses")
}

enum TrainingSessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model TrainingSession {
  id        String                 @id @default(uuid())
  courseId  String
  startDate DateTime
  endDate   DateTime
  location  String?
  status    TrainingSessionStatus  @default(SCHEDULED)
  cost      Decimal?               @db.Decimal(18, 2)

  course      TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollments TrainingEnrollment[]

  @@index([courseId])
  @@map("training_sessions")
}

enum TrainingEnrollmentStatus {
  ENROLLED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model TrainingEnrollment {
  id               String                    @id @default(uuid())
  sessionId        String
  employeeId       String
  status           TrainingEnrollmentStatus  @default(ENROLLED)
  completionScore  Decimal?                  @db.Decimal(5, 2)
  evaluationRating Int? // 1-5 post-training evaluation
  evaluationComments String?

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  certification Certification?

  @@unique([sessionId, employeeId])
  @@index([employeeId])
  @@map("training_enrollments")
}

model Certification {
  id                   String   @id @default(uuid())
  employeeId           String
  trainingEnrollmentId String?  @unique
  name                 String
  issuedBy             String?
  issueDate            DateTime
  expiryDate           DateTime?
  certificateUrl       String?

  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("certifications")
}

// ---- Succession Planning ----

enum SuccessionReadiness {
  READY_NOW
  READY_1_2_YEARS
  READY_3_5_YEARS
  DEVELOPING
}

enum SuccessionCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SuccessionPlan {
  id                 String                 @id @default(uuid())
  entityId           String
  positionTitle      String
  incumbentEmployeeId String?
  criticality        SuccessionCriticality  @default(MEDIUM)
  notes              String?

  createdAt DateTime @default(now())

  entity     Entity                @relation(fields: [entityId], references: [id], onDelete: Restrict)
  incumbent  Employee?             @relation("SuccessionIncumbent", fields: [incumbentEmployeeId], references: [id], onDelete: Restrict)
  candidates SuccessionCandidate[]

  @@index([entityId, criticality])
  @@map("succession_plans")
}

model SuccessionCandidate {
  id               String              @id @default(uuid())
  successionPlanId String
  employeeId       String
  readiness        SuccessionReadiness @default(DEVELOPING)
  isHighPotential  Boolean             @default(false)
  developmentNotes String?

  successionPlan SuccessionPlan @relation(fields: [successionPlanId], references: [id], onDelete: Restrict)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([successionPlanId, employeeId])
  @@map("succession_candidates")
}

// =====================================================================
// PRODUCTION INFRASTRUCTURE
// -----------------------------------------------------------------------
// Added for the background-worker / job-queue rollout. These models are
// purely additive: no existing model, field, enum, or relation above this
// point was modified. Every relation below defaults to onDelete: Cascade
// only where justified (pure operational/config data with no independent
// audit or financial meaning of its own), matching the deletion policy
// documented at the top of this file.
// =====================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  // Release ID.2 Part 1 Ã¢â‚¬â€ WhatsApp Cloud API (additive)
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
  // Release ID Ã¢â‚¬â€ SMS Integration (Delivery Receipts). Distinct from SENT
  // (handed to the provider) Ã¢â‚¬â€ set only once Twilio's status-callback
  // webhook confirms actual device delivery. EMAIL/IN_APP notifications
  // never reach this status in this release (no delivery-receipt webhook
  // exists for those channels yet).
  DELIVERED
}

// In-app / emailed notifications generated by background jobs (payroll
// run completed, bank import finished, report ready, budget threshold
// breached, etc.) as well as ad-hoc notifications raised by the API.
model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  // Release IC.4 (Email Template Engine, additive). Populated only when the
  // notification was created from an EmailTemplate with an htmlTemplate Ã¢â‚¬â€
  // every existing call site that doesn't pass a template leaves this null,
  // and NotificationProcessor's IN_APP path never reads it (the web app's
  // notification list still renders `body` as plain text, unchanged).
  bodyHtml  String?
  metadata  Json?
  readAt    DateTime?
  sentAt    DateTime?
  // Release ID Ã¢â‚¬â€ SMS Integration (Delivery Receipts). providerMessageId is
  // Twilio's message SID, set by SmsProcessor right after a successful
  // send Ã¢â‚¬â€ SmsWebhookController looks a notification up by this field to
  // apply an incoming status-callback to the right row. Both null for
  // every non-SMS notification and for any SMS send that failed before a
  // SID was ever issued.
  providerMessageId String?
  deliveredAt       DateTime?
  createdAt DateTime            @default(now())

  // CASCADE justified: a notification is a disposable operational message
  // with no independent audit/financial meaning once its recipient is gone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([providerMessageId])
  @@index([createdAt])
  @@map("notifications")
}

/// Release IC.4 Ã¢â‚¬â€ Email Template Engine (additive). `{{variableName}}`
/// placeholders only (no logic/loops/partials) Ã¢â‚¬â€ deliberately not a full
/// templating engine like Handlebars: every value substituted into
/// htmlTemplate is HTML-escaped by EmailTemplateService, so there is no
/// script-injection surface to reason about, and no new npm dependency is
/// needed (same "reuse Node built-ins over adding a library" preference
/// already established by acquireGoogleAccessToken using global fetch
/// instead of googleapis, and GmailMailService reusing nodemailer's
/// MailComposer instead of a MIME library).
model EmailTemplate {
  id              String   @id @default(uuid())
  /// e.g. "WELCOME_EMAIL", "PASSWORD_RESET", "INVOICE_OVERDUE" Ã¢â‚¬â€ what callers pass to EmailTemplateService.render().
  code            String   @unique
  name            String
  description     String?
  subjectTemplate String
  /// Null for a text-only template Ã¢â‚¬â€ NotificationsService then leaves Notification.bodyHtml unset and the email sends as plain text only, same as every notification before this release.
  htmlTemplate    String?
  textTemplate    String
  /// Documents which {{variable}} placeholders this template expects.
  /// Informational only (not enforced by a JSON-schema validator) Ã¢â‚¬â€ same
  /// treatment IntegrationProvider.config gets, consistent with this
  /// schema's existing convention of leaving free-form Json? columns
  /// unvalidated at the database layer.
  variables       Json?
  isActive        Boolean  @default(true)
  /// Incremented by EmailTemplateService on every update. Full before/after
  /// history of every change is already captured by the global
  /// AuditInterceptor (audit_logs) Ã¢â‚¬â€ this column is just "which version am
  /// I looking at", not a duplicate history mechanism.
  version         Int      @default(1)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("email_templates")
}

// Runtime feature toggles. Read by both the API and the worker; changes
// take effect without a redeploy (subject to each reader's cache TTL).
model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  // Optional 0-100 rollout percentage for gradual enablement; when set,
  // readers should hash a stable identifier (e.g. entityId/userId) against
  // this value rather than treating the flag as a simple boolean.
  rolloutPercent Int?
  metadata    Json?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flags")
}

enum JobRunStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

// Execution history for background jobs, written by the worker for every
// queue processor run. This is observability data (queue dashboard,
// /health readiness signal, audit trail for "why didn't my payroll run
// calculate") Ã¢â‚¬â€ not a replacement for BullMQ's own Redis-backed job state.
model JobRunLog {
  id          String       @id @default(uuid())
  queueName   String
  jobName     String
  jobId       String
  status      JobRunStatus @default(QUEUED)
  payload     Json?
  result      Json?
  errorMessage String?
  attemptsMade Int         @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([queueName, status])
  @@index([jobId])
  @@index([createdAt])
  @@map("job_run_logs")
}

// =====================================================================
// Release IA Ã¢â‚¬â€ CORE INTEGRATION FRAMEWORK (additive)
// =====================================================================
// The foundation the rest of the Enterprise Integrations roadmap (cloud
// storage, email, SMS/WhatsApp, payment gateways, banking, Microsoft
// Graph, Google Workspace, digital signatures, Power BI, API gateway Ã¢â‚¬â€
// Releases IB onward) builds on: one registry table for every configured
// third-party provider, credentials encrypted at rest (never returned by
// the API once written Ã¢â‚¬â€ see IntegrationsService), a per-provider retry
// policy the queue producer/worker can read instead of hardcoding one,
// and a health-check result cached on the row itself (no separate log
// table needed yet Ã¢â‚¬â€ reconsider if per-check history is needed later).
// Concrete provider drivers (AWS S3, Twilio, Paystack, ...) are NOT part
// of this release; IntegrationProviderDriver in
// apps/api/src/integrations/integration-provider-driver.interface.ts is
// the abstraction later releases implement against, same shape as
// StorageProvider in apps/api/src/storage/storage.interface.ts.

enum IntegrationCategory {
  STORAGE
  EMAIL
  SMS
  WHATSAPP
  PAYMENT
  BANKING
  MICROSOFT_GRAPH
  GOOGLE_WORKSPACE
  DIGITAL_SIGNATURE
  POWER_BI
  API_GATEWAY
  OTHER
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  DEGRADED
  ERROR
}

/// One row per configured third-party integration. entityId is nullable Ã¢â‚¬â€
/// most integrations (e.g. a single company-wide S3 bucket or SMTP relay)
/// are configured once for the whole system, but a provider can be scoped
/// to one entity when that's how the vendor relationship actually works
/// (e.g. a bank integration tied to one legal entity's account).
model IntegrationProvider {
  id                    String               @id @default(uuid())
  entityId              String?
  category              IntegrationCategory
  providerCode          String               // e.g. "AWS_S3", "SMTP", "TWILIO", "PAYSTACK" Ã¢â‚¬â€ free text by design, see IntegrationProviderDriver
  name                  String
  status                IntegrationStatus    @default(INACTIVE)
  isActive              Boolean              @default(true)
  config                Json?                // non-secret settings (bucket name, region, sender address, ...)
  encryptedCredentials  String?              // AES-256-GCM ciphertext of a JSON secret blob Ã¢â‚¬â€ see IntegrationEncryptionService
  retryMaxAttempts      Int                  @default(3)
  retryBackoffMs        Int                  @default(2000)
  lastHealthCheckAt     DateTime?
  lastHealthCheckOk     Boolean?
  lastHealthCheckError  String?
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  entity    Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User    @relation("IntegrationProviderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([category, providerCode, entityId])
  @@index([entityId, status])
  @@index([category])
  @@map("integration_providers")
}

// =====================================================================
// FIXED ASSETS CORE (Release, additive)
// =====================================================================
// Asset register + straight-line depreciation engine, posting through the
// existing PostingEngineService.postSystemEntry (same pattern as
// Revenue Recognition / Payroll), plus disposal accounting. Reducing-
// balance and other methods are represented in the enum for forward
// compatibility but are not implemented by the service in this release Ã¢â‚¬â€
// see DepreciationMethod doc comment.

enum FixedAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

/// Only STRAIGHT_LINE is computed by DepreciationService in this release.
/// Additional methods are reserved here so a future release can add the
/// calculation without another migration.
enum DepreciationMethod {
  STRAIGHT_LINE
}

enum DepreciationEntryStatus {
  PENDING
  POSTED
}

/// Groups fixed assets under a common useful life/GL mapping default
/// (e.g. "IT Equipment", "Motor Vehicles", "Office Furniture").
model AssetCategory {
  id                     String             @id @default(uuid())
  name                   String             @unique
  defaultUsefulLifeYears Int
  defaultDepreciationMethod DepreciationMethod @default(STRAIGHT_LINE)

  assetAccountId                   String
  accumulatedDepreciationAccountId String
  depreciationExpenseAccountId     String

  assetAccount                   Account @relation("FixedAssetCategoryAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  accumulatedDepreciationAccount Account @relation("FixedAssetCategoryAccDeprAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)
  depreciationExpenseAccount     Account @relation("FixedAssetCategoryDeprExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixedAssets FixedAsset[]

  @@map("asset_categories")
}

model FixedAsset {
  id       String @id @default(uuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  assetCategoryId String
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)

  assetTag    String // human-readable tag, unique per entity e.g. "7FC-IT-0042"
  name        String
  description String?

  acquisitionDate DateTime
  acquisitionCost Decimal  @db.Decimal(18, 2)
  residualValue   Decimal  @db.Decimal(18, 2) @default(0)
  usefulLifeYears Int // overrides AssetCategory.defaultUsefulLifeYears for this asset
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  locationName String?
  status       FixedAssetStatus @default(ACTIVE)

  // Denormalized cursor so DepreciationService can find "next period due"
  // without scanning DepreciationEntry for every asset on every run.
  lastDepreciatedThrough DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depreciationEntries DepreciationEntry[]
  disposal            AssetDisposal?

  @@unique([entityId, assetTag])
  @@index([entityId])
  @@index([assetCategoryId])
  @@index([status])
  @@map("fixed_assets")
}

/// One row per asset per monthly depreciation run. periodDate is
/// normalized to the first of the month it covers.
model DepreciationEntry {
  id           String @id @default(uuid())
  fixedAssetId String
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)

  periodDate              DateTime
  depreciationAmount      Decimal  @db.Decimal(18, 2)
  accumulatedDepreciation Decimal  @db.Decimal(18, 2) // running total as of this entry
  netBookValue            Decimal  @db.Decimal(18, 2) // acquisitionCost - accumulatedDepreciation

  status DepreciationEntryStatus @default(PENDING)

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  postedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([fixedAssetId, periodDate])
  @@index([fixedAssetId])
  @@index([status])
  @@map("depreciation_entries")
}

/// A fixed asset can be disposed at most once (one-to-one); re-disposal
/// attempts are rejected in the service layer against FixedAsset.status.
model AssetDisposal {
  id           String @id @default(uuid())
  fixedAssetId String @unique
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)

  disposalDate           DateTime
  disposalProceeds       Decimal  @db.Decimal(18, 2) @default(0)
  netBookValueAtDisposal Decimal  @db.Decimal(18, 2)
  gainLoss               Decimal  @db.Decimal(18, 2) // proceeds - netBookValueAtDisposal

  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  disposedById String
  disposedBy   User   @relation("AssetDisposedBy", fields: [disposedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@map("asset_disposals")
}

// =====================================================================
// TAX CENTER CORE (Release, additive)
// =====================================================================
// Reference-data layer for the WHT/VAT withholding mechanics that
// already exist inside Accounts Payable (WHTDeduction / VATDeduction,
// see the Financial Core section above). TaxCode does NOT replace or
// change how AP creates those deductions Ã¢â‚¬â€ CreatePaymentVoucherDto still
// takes an explicit rate/authority per allocation, unchanged, per the
// "never modify existing implementations" rule. TaxCode exists so a
// future release can look values up from here instead; today it backs
// TaxService's own validation plus the consolidated tax-position report.

enum TaxType {
  WHT
  VAT
}

model TaxCode {
  id       String  @id @default(uuid())
  code     String  @unique // e.g. "WHT-SERVICES-5", "VAT-STANDARD"
  name     String
  taxType  TaxType
  rate     Decimal @db.Decimal(6, 4)
  jurisdiction String? // e.g. country/state the rate applies in

  taxAuthorityAccountId String
  taxAuthorityAccount   Account @relation("TaxCodeAuthorityAccount", fields: [taxAuthorityAccountId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_codes")
}

// =====================================================================
// PMO SCHEDULING CORE (Release H, additive)
// =====================================================================
// Deliberately separate from the existing contract-admin "pmo" concerns
// (Boq/WorkPackage/ProgressValuation/Certificate/VariationOrder/
// RetentionRelease) Ã¢â‚¬â€ those model contractor payment administration;
// this models project scheduling (WBS, dependencies, critical path,
// earned value). Both live under the same PMO permission codes
// (pmo.manage/pmo.view/pmo.approve), reused as-is, no new permissions.

enum ProjectTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

/// A WBS node. Self-referencing parentTaskId gives the work-breakdown
/// hierarchy; TaskDependency gives the network logic used for critical
/// path. budgetedCost/actualCost are simple flat fields here rather than
/// pulled live from Budgeting/AP Ã¢â‚¬â€ reusing those would require a
/// materially larger, riskier cost-rollup integration than this release's
/// scope; a follow-up release can wire that in additively.
model ProjectTask {
  id              String            @id @default(uuid())
  projectId       String
  entityId        String
  parentTaskId    String?
  code            String?
  name            String
  description     String?
  isMilestone     Boolean           @default(false)
  plannedStart    DateTime
  plannedEnd      DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  percentComplete Int               @default(0)
  status          ProjectTaskStatus @default(NOT_STARTED)
  budgetedCost    Decimal?          @db.Decimal(18, 2)
  actualCost      Decimal?          @db.Decimal(18, 2)
  // Populated by SchedulingService.computeCriticalPath() Ã¢â‚¬â€ not
  // hand-edited; treat as derived/cached output of that calculation.
  isCritical      Boolean           @default(false)
  totalFloatDays  Int?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entity     Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  parentTask ProjectTask? @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks ProjectTask[] @relation("TaskHierarchy")
  createdBy  User         @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  predecessorOf TaskDependency[] @relation("TaskPredecessor")
  successorOf   TaskDependency[] @relation("TaskSuccessor")
  // Release J (PMO Resource & Equipment/Labour Allocation, additive)
  resourceAllocations ResourceAllocation[]

  @@index([projectId, status])
  @@index([parentTaskId])
  @@index([entityId])
  @@map("project_tasks")
}

model TaskDependency {
  id            String             @id @default(uuid())
  predecessorId String
  successorId   String
  type          TaskDependencyType @default(FINISH_TO_START)
  lagDays       Int                @default(0)
  createdAt     DateTime           @default(now())

  predecessor ProjectTask @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor   ProjectTask @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Restrict)

  @@unique([predecessorId, successorId])
  @@map("task_dependencies")
}

// =====================================================================
// PMO RISK & ISSUE MANAGEMENT (Release I, additive)
// =====================================================================
// A Risk that occurs converts into an Issue via convertRiskToIssue() Ã¢â‚¬â€
// modeled as a link (Issue.riskId), not a status-only field, so a risk's
// full lifecycle (identified -> assessed -> mitigated -> occurred) stays
// intact even after the resulting issue is independently tracked and
// resolved.

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  MITIGATING
  MONITORING
  OCCURRED
  CLOSED
}

model ProjectRisk {
  id              String          @id @default(uuid())
  projectId       String
  entityId        String
  title           String
  description     String?
  category        String?
  probability     RiskProbability @default(MEDIUM)
  impact          RiskImpact      @default(MEDIUM)
  // 1-9, probability x impact on a 1/2/3 scale each Ã¢â‚¬â€ simple, standard
  // risk-matrix scoring rather than a full quantitative model.
  riskScore       Int
  status          RiskStatus      @default(IDENTIFIED)
  ownerId         String?
  mitigationPlan  String?
  identifiedById  String
  identifiedAt    DateTime        @default(now())
  closedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entity       Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  owner        User?          @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  identifiedBy User           @relation("RiskIdentifiedBy", fields: [identifiedById], references: [id], onDelete: Restrict)
  issues       ProjectIssue[]

  @@index([projectId, status])
  @@index([entityId])
  @@map("project_risks")
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

model ProjectIssue {
  id              String        @id @default(uuid())
  projectId       String
  entityId        String
  riskId          String?
  title           String
  description     String?
  priority        IssuePriority @default(MEDIUM)
  status          IssueStatus   @default(OPEN)
  assignedToId    String?
  raisedById      String
  raisedAt        DateTime      @default(now())
  dueDate         DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entity     Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  risk       ProjectRisk? @relation(fields: [riskId], references: [id], onDelete: Restrict)
  assignedTo User?        @relation("IssueAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  raisedBy   User         @relation("IssueRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([entityId])
  @@index([riskId])
  @@map("project_issues")
}

// =====================================================================
// PMO RESOURCE & EQUIPMENT/LABOUR ALLOCATION (Release J, additive)
// =====================================================================
// One ResourceAllocation model serves both "Equipment Allocation" and
// "Labour Allocation" Ã¢â‚¬â€ the distinction is purely ProjectResource.type,
// not two near-identical tables. Deliberately does not integrate with
// Budgeting/AP costing yet (same documented scope limitation as
// ProjectTask.budgetedCost in Release H) Ã¢â‚¬â€ a follow-up release can wire
// resource cost roll-ups in additively.

enum ResourceType {
  LABOUR
  EQUIPMENT
}

model ProjectResource {
  id             String       @id @default(uuid())
  projectId      String
  entityId       String
  type           ResourceType
  name           String
  code           String?
  unitOfMeasure  String?
  unitCost       Decimal?     @db.Decimal(18, 2)
  // Total concurrent capacity this resource can support (e.g. crew
  // headcount, or number of identical equipment units) Ã¢â‚¬â€ used by
  // ResourceService.allocateResource() to reject over-booking.
  capacity       Int?
  isActive       Boolean      @default(true)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entity    Entity  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User    @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  allocations ResourceAllocation[]

  @@index([projectId, type])
  @@index([entityId])
  @@map("project_resources")
}

enum ResourceAllocationStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model ResourceAllocation {
  id              String                    @id @default(uuid())
  resourceId      String
  taskId          String
  entityId        String
  startDate       DateTime
  endDate         DateTime
  plannedQuantity Decimal                   @db.Decimal(10, 2)
  actualQuantity  Decimal?                  @db.Decimal(10, 2)
  status          ResourceAllocationStatus  @default(PLANNED)
  notes           String?
  cancelledReason String?
  createdById     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  resource  ProjectResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  task      ProjectTask     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  entity    Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User            @relation("ResourceAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([resourceId, status])
  @@index([taskId])
  @@index([entityId])
  @@map("resource_allocations")
}

// =====================================================================
// RELEASE M Ã¢â‚¬â€ MFA (TOTP), QR Enrollment, Recovery Codes (additive)
// =====================================================================

/// One-time-use recovery codes issued when a user completes MFA
/// enrollment. Hashed with the same SHA-256 convention RefreshToken uses
/// for its tokenHash Ã¢â‚¬â€ these are single-use bearer secrets, not
/// passwords, so bcrypt's slow-hash design isn't needed and a fast hash
/// keeps verification cheap during a login flow that already did one
/// bcrypt compare for the password step.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // CASCADE justified: identical reasoning to RefreshToken Ã¢â‚¬â€ a recovery
  // code has no value once its owning user is gone.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// =====================================================================
// PAYMENT GATEWAY Ã¢â‚¬â€ TRANSACTION MODEL (Release IE.1, Checkpoint C)
// =====================================================================
// Deliberately additive-only, matching Checkpoint A/B: still no worker,
// queue, webhook handler, or controller wired to this yet (Checkpoints
// D-I). providerCode is a plain string (e.g. "PAYSTACK"), matching
// PaymentProviderRegistry's lookup key from Checkpoint B Ã¢â‚¬â€ NOT a foreign
// key to a specific IntegrationProvider row, since the abstraction layer
// doesn't address a specific provider *account*, just a provider *type*.
// If multi-account-per-provider support is ever needed, that's a
// separate additive column, not a redesign of this one.
//
// amount is always the currency's minor unit (integer) Ã¢â‚¬â€ see
// payment-provider.interface.ts's design notes; PaymentTransactionStatus
// mirrors that file's PaymentStatus string union value-for-value on
// purpose, so nothing downstream has to translate between two
// vocabularies for the same concept.

enum PaymentTransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  ABANDONED
}

model PaymentTransaction {
  id                String                   @id @default(uuid())
  /// Caller-supplied, must be idempotent (see payment-provider.interface.ts) Ã¢â‚¬â€ enforced here with @unique.
  reference         String                   @unique
  entityId          String
  providerCode      String
  amount            Int
  currency          String
  status            PaymentTransactionStatus @default(PENDING)
  customerEmail     String
  description       String?
  authorizationUrl  String?
  providerReference String?
  metadata          Json?
  paidAt            DateTime?
  /// The provider's full raw verification response Ã¢â‚¬â€ audit trail, never parsed by callers. Same treatment IntegrationProvider.config gets: an unvalidated free-form Json? column.
  rawVerification   Json?
  createdById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  entity    Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User            @relation("PaymentTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  refunds   PaymentRefund[]

  @@index([entityId, status])
  @@index([providerCode])
  @@map("payment_transactions")
}

enum PaymentRefundStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model PaymentRefund {
  id                   String              @id @default(uuid())
  paymentTransactionId String
  /// Caller/provider-supplied, must be idempotent Ã¢â‚¬â€ same reasoning as PaymentTransaction.reference.
  refundReference      String              @unique
  amount               Int
  status               PaymentRefundStatus @default(PENDING)
  reason               String?
  rawResponse          Json?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  createdBy          User               @relation("PaymentRefundCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([paymentTransactionId])
  @@map("payment_refunds")
}

// =====================================================================
// AGENT MANAGEMENT (RE-AGENT.1, additive)
// =====================================================================
// A real, standalone external-sales-agent master, distinct from both
// the CRM Lead's LeadSource.AGENT enum value (which only tags *where a
// lead came from*, carrying no agent identity, license, bank, or tax
// data at all) and from User (an ERP login/permissions principal).
// Deliberately has NO relation to User other than the audit-trail
// createdBy/reviewedBy columns every other master record in this
// codebase already carries (see ApiKey.createdBy for the same pattern)
// Ã¢â‚¬â€ an Agent is never itself a login, and a User is never repurposed
// to represent one, per this checkpoint's own scope: agent-to-sale/
// unit/project assignment and commission plans/calculation are
// deliberately separate, later checkpoints (RE-AGENT.2, RE-COMM.1-6)
// and are NOT implemented by this model.
//
// code is caller-supplied and unique, matching Vendor.code/
// Customer.code's existing convention elsewhere in this schema (no
// auto-generation service to keep in sync).
//
// entityId scopes the agent to the legal entity that engaged them Ã¢â‚¬â€
// reuses the existing Entity dimension (see RowLevelSecurityService)
// rather than introducing a new one, same as every other entity-scoped
// master record in this file.

enum AgentType {
  INDIVIDUAL
  COMPANY
  BROKER
}

/// PENDING_APPROVAL -> ACTIVE -> SUSPENDED -> ACTIVE (reactivation) is
/// the only cycle; TERMINATED is terminal from any of the other three.
/// Enforced by AgentService's own guarded transition methods, never by
/// a direct `status` field update via the general update endpoint Ã¢â‚¬â€ see
/// UpdateAgentDto's own doc comment for why `status` is deliberately
/// absent from it.
enum AgentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Agent {
  id         String      @id @default(uuid())
  code       String      @unique
  agentType  AgentType
  status     AgentStatus @default(PENDING_APPROVAL)

  // Individual/company/broker classification (RE-AGENT.1). displayName
  // is always required (the person's name for INDIVIDUAL, the
  // company/brokerage's registered name for COMPANY/BROKER);
  // contactPersonName is the human to reach at a COMPANY/BROKER agent
  // and is deliberately nullable for INDIVIDUAL, where displayName
  // already names that same person Ã¢â‚¬â€ not enforced at the database
  // level (no CHECK constraint) since that pairing is a data-entry
  // convention AgentService's own validation applies, not a structural
  // guarantee.
  displayName       String
  contactPersonName String?

  email        String
  phone        String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?

  // License/registration information.
  licenseNumber        String?
  licenseIssuingBody   String?
  licenseExpiryDate    DateTime?
  registrationNumber   String?

  // Entity relationship Ã¢â‚¬â€ which 7F LedgerOS legal entity this agent is
  // engaged under. See this section's own top comment for why this
  // reuses the existing Entity dimension rather than a new one.
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  // Bank/payment information Ã¢â‚¬â€ same shape as Vendor's own
  // bankName/bankAccountNumber columns, extended with an account-name
  // and an optional SWIFT/routing code since agent commission payouts
  // are wired transfers, same as vendor payments.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankSwiftCode     String?

  // Tax information.
  taxIdentificationNumber String?
  /// True when this agent is exempt from withholding tax on commission
  /// payouts Ã¢â‚¬â€ read by the (later, RE-COMM.2) commission-calculation
  /// checkpoint; stored here since it's a property of the agent, not of
  /// any one commission transaction.
  withholdingTaxExempt Boolean @default(false)

  // Agent agreement/reference.
  agreementReference String?
  agreementStartDate DateTime?
  agreementEndDate   DateTime?

  // Status lifecycle detail Ã¢â‚¬â€ see AgentStatus's own doc comment for the
  // allowed transitions. Populated only by the corresponding
  // AgentService method, never directly.
  approvedById   String?
  approvedAt     DateTime?
  suspendedById  String?
  suspendedAt    DateTime?
  suspendReason  String?
  terminatedById String?
  terminatedAt   DateTime?
  terminateReason String?

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User  @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  suspendedBy User? @relation("AgentSuspendedBy", fields: [suspendedById], references: [id], onDelete: Restrict)
  terminatedBy User? @relation("AgentTerminatedBy", fields: [terminatedById], references: [id], onDelete: Restrict)

  @@index([entityId])
  @@index([status])
  @@index([agentType])
  @@map("agents")

  assignments AgentAssignment[]
  // Agent & Commission Management, RE-COMM.1 (additive)
  commissionPlans CommissionPlan[]
  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculations CommissionCalculation[]
}

// =====================================================================
// AGENT & COMMISSION MANAGEMENT Ã¢â‚¬â€ RE-AGENT.2: Agent Assignment (additive)
// =====================================================================

/// Which kind of target this assignment attaches to. Exactly one of
/// AgentAssignment.projectId/unitId/allocationId is populated to match Ã¢â‚¬â€
/// enforced by AgentAssignmentService.validateTarget(), not a DB CHECK
/// constraint (no precedent for hand-written CHECK constraints elsewhere
/// in this schema's own migrations, so this stays consistent with how
/// e.g. Agent.displayName/contactPersonName's own cross-field pairing is
/// already handled: a service-level convention, not a structural
/// guarantee).
enum AgentAssignmentScope {
  PROJECT
  UNIT
  SALE
}

/// PRIMARY: at most one ACTIVE PRIMARY per (scope, target) pair Ã¢â‚¬â€ a
/// second PRIMARY is rejected with a 409 by AgentAssignmentService,
/// never silently swaps the existing one out (matching AgentService's
/// own "reject, don't silently ignore" convention for an invalid state
/// change). CO_AGENT/REFERRAL have no such limit Ã¢â‚¬â€ several may be
/// simultaneously active on the same target.
enum AgentAssignmentRole {
  PRIMARY
  CO_AGENT
  REFERRAL
}

model AgentAssignment {
  id      String               @id @default(uuid())
  agentId String
  scope   AgentAssignmentScope
  role    AgentAssignmentRole

  // The target this assignment is for Ã¢â‚¬â€ exactly one of these three is
  // set, matching `scope`. SALE means "this confirmed sale transaction"
  // (UnitSaleAllocation already links a specific unit + customer, which
  // is why the master prompt's own "customer/sale" pairing collapses to
  // this one relation rather than a separate customerId column).
  projectId    String?
  unitId       String?
  allocationId String?

  // Denormalized for RLS/reporting, same "don't derive via a multi-hop
  // join on every query" rationale as UnitReservation.entityId/projectId.
  // entityId is caller-supplied on create (enabling @RlsBodyCheck on the
  // route, before the handler runs Ã¢â‚¬â€ same convention as
  // CreateAgentDto.entityId/UnitReservation.entityId) but
  // AgentAssignmentService cross-validates it against the target's own
  // real structural entity (Project.entityId directly, or via
  // Unit/UnitSaleAllocation -> Floor -> Block -> Phase -> Project) and
  // rejects a mismatch with a 400 rather than trusting it blindly Ã¢â‚¬â€ a
  // deliberate strengthening beyond UnitReservation's own precedent,
  // since a wrong entityId here would misfile RLS-scoped assignment
  // history. projectId is always resolved server-side the same way,
  // even for UNIT/SALE scope, and never taken from the caller.
  entityId String

  isActive    Boolean   @default(true)
  endedAt     DateTime?
  endedReason String?
  endedById   String?

  notes String?

  assignedAt  DateTime @default(now())
  createdById String

  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Restrict)
  entity     Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict)
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unit       Unit?               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  allocation UnitSaleAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("AgentAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy    User?               @relation("AgentAssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculations CommissionCalculation[]

  @@index([agentId])
  @@index([entityId])
  @@index([projectId])
  @@index([unitId])
  @@index([allocationId])
  @@index([scope, role, isActive])
  @@map("agent_assignments")
}

// =====================================================================
// AGENT & COMMISSION MANAGEMENT Ã¢â‚¬â€ RE-COMM.1: Commission Plans (additive)
// =====================================================================
// A configurable commission-structure master. Deliberately does NOT
// compute or post anything Ã¢â‚¬â€ that is RE-COMM.2 (Commission Calculation)
// and RE-COMM.4 (Financial Integration via the existing
// PostingEngineService). This checkpoint only defines *what rate/amount
// applies*, not *when* or *how it gets paid*.
//
// Scope model: exactly one of projectId/estateId/unitId/agentId is
// populated to match `scope`, mirroring AgentAssignment's own
// "exactly one target column, enforced by the service not a DB CHECK"
// convention (see AgentAssignmentScope's own doc comment for why no
// hand-written CHECK constraint is used anywhere in this schema).
// GLOBAL leaves all four null Ã¢â‚¬â€ the fallback plan for an
// entity when nothing more specific matches.
//
// Plan resolution precedence (most-specific wins), enforced by
// CommissionPlanService, not stored on the row itself:
// UNIT > PROJECT > ESTATE > AGENT > GLOBAL. Multiple active plans can
// legally coexist (e.g. a GLOBAL default plus a PROJECT override) Ã¢â‚¬â€
// resolution is a lookup concern for the (later) calculation
// checkpoint, not a uniqueness constraint here, since e.g. an
// AGENT-scoped plan and a PROJECT-scoped plan may both legitimately be
// ACTIVE for the same entity at once and only their combination (an
// agent selling a unit in that project) makes one of them the actual
// answer.
enum CommissionPlanType {
  PERCENTAGE
  FIXED
}

enum CommissionPlanScope {
  GLOBAL
  PROJECT
  ESTATE
  UNIT
  AGENT
}

/// ACTIVE plans are eligible to be resolved against a sale. INACTIVE is
/// a soft-disable (deactivate), never a delete Ã¢â‚¬â€ commission plans may
/// already be referenced by historical commission calculations (once
/// RE-COMM.2 exists) and must remain inspectable. Enforced only by
/// CommissionPlanService.deactivate(); there is no reactivation
/// endpoint in this checkpoint's own scope Ã¢â‚¬â€ create a new plan instead,
/// the same "don't silently resurrect a superseded rate" discipline
/// AgentStatus.TERMINATED's own doc comment applies to agents.
enum CommissionPlanStatus {
  ACTIVE
  INACTIVE
}

model CommissionPlan {
  id     String                @id @default(uuid())
  code   String                @unique
  name   String
  type   CommissionPlanType
  scope  CommissionPlanScope
  status CommissionPlanStatus  @default(ACTIVE)

  // Entity relationship Ã¢â‚¬â€ which 7F LedgerOS legal entity this plan
  // applies under (same dimension every other master record in this
  // file reuses, see Agent.entityId's own doc comment).
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  // Scope target Ã¢â‚¬â€ exactly one of these four is populated to match
  // `scope`; all four null means GLOBAL. Validated by
  // CommissionPlanService.validateScopeTarget(), not a DB CHECK
  // constraint (see this section's own top comment).
  projectId String?
  estateId  String?
  unitId    String?
  agentId   String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  estate  Estate?  @relation(fields: [estateId], references: [id], onDelete: Restrict)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  agent   Agent?   @relation(fields: [agentId], references: [id], onDelete: Restrict)

  // Flat rate/amount Ã¢â‚¬â€ required (and the only rate source) when
  // isTiered is false. When isTiered is true, both are null and
  // `tiers` supplies the schedule instead Ã¢â‚¬â€ enforced by
  // CommissionPlanService, not a DB CHECK.
  rate        Decimal? @db.Decimal(9, 4)  // percentage, e.g. 2.5000 = 2.5%, used when type=PERCENTAGE
  fixedAmount Decimal? @db.Decimal(18, 2) // used when type=FIXED

  // Referral commission Ã¢â‚¬â€ a distinct, typically-lower rate paid to a
  // referring agent rather than the primary/co-agent. Modeled as a
  // flag on the same plan shape (not a separate model) since a
  // referral plan is structurally identical to any other Ã¢â‚¬â€ same
  // type/scope/rate/tier machinery, just resolved for
  // AgentAssignmentRole.REFERRAL assignments instead of PRIMARY/CO_AGENT
  // (a RE-COMM.2 concern; this checkpoint only stores the flag).
  isReferral Boolean @default(false)

  // Tiered commission Ã¢â‚¬â€ when true, `tiers` (ordered, gapless,
  // non-overlapping bands over the commission basis amount) supplies
  // the schedule instead of the flat rate/fixedAmount above. Validated
  // by CommissionPlanService.validateTiers() at create/update time.
  isTiered Boolean @default(false)
  tiers    CommissionPlanTier[]

  effectiveFrom DateTime
  effectiveTo   DateTime?

  notes String?

  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedById String?
  deactivatedAt   DateTime?
  deactivateReason String?

  createdBy     User  @relation("CommissionPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deactivatedBy User? @relation("CommissionPlanDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)

  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculations CommissionCalculation[]

  @@index([entityId])
  @@index([scope])
  @@index([projectId])
  @@index([estateId])
  @@index([unitId])
  @@index([agentId])
  @@index([status])
  @@index([isReferral])
  @@map("commission_plans")
}

/// One band of a tiered CommissionPlan. Bands are ordered by
/// `tierOrder` (1-based) and must be gapless/non-overlapping over the
/// commission basis amount: tier N's minAmount equals tier N-1's
/// maxAmount, and only the final tier may have a null maxAmount (open
/// upper end) Ã¢â‚¬â€ enforced by CommissionPlanService.validateTiers(), not
/// a DB CHECK constraint (see the parent model's own top comment for
/// why this schema has no precedent for hand-written CHECK
/// constraints). Exactly one of rate/fixedAmount is populated per tier,
/// matching the parent CommissionPlan's own `type`.
model CommissionPlanTier {
  id               String  @id @default(uuid())
  commissionPlanId String
  tierOrder        Int
  minAmount        Decimal @db.Decimal(18, 2)
  maxAmount        Decimal? @db.Decimal(18, 2)
  rate             Decimal? @db.Decimal(9, 4)
  fixedAmount      Decimal? @db.Decimal(18, 2)

  commissionPlan CommissionPlan @relation(fields: [commissionPlanId], references: [id], onDelete: Cascade)

  @@unique([commissionPlanId, tierOrder])
  @@map("commission_plan_tiers")
}

// =====================================================================
// AGENT & COMMISSION MANAGEMENT Ã¢â‚¬â€ RE-COMM.2: Commission Calculation (additive)
// =====================================================================
// Computes and stores a single commission amount for one AgentAssignment
// against the confirmed sale (UnitSaleAllocation) it was made on Ã¢â‚¬â€ the
// master prompt's own explicit "traceable back to the underlying
// property transaction" requirement. Deliberately does NOT introduce an
// approval/payment workflow (CALCULATED -> PENDING -> APPROVED ->
// PAYABLE -> PAID) Ã¢â‚¬â€ that full state machine is RE-COMM.3 (Commission
// Lifecycle), a separate checkpoint. This model's own `status` only
// distinguishes a live calculation from one that has been reversed or
// cancelled, since a sale/assignment can be cancelled or reversed after
// a commission was already calculated against it and that must be
// recorded, not silently deleted.
//
// Every numeric input this calculation used is snapshotted onto the row
// itself (sale value, discount, the specific plan/rate/tier applied, the
// WHT rate/authority) rather than only stored as live FK references Ã¢â‚¬â€
// the same discipline CommissionPlan's own scope-target fields already
// establish for "resolve once, don't re-derive live on every read": a
// later edit to the CommissionPlan this calculation used, or a later
// change to the TaxCode's rate, must never retroactively alter an
// already-calculated historical commission amount.
enum CommissionBasisType {
  GROSS
  NET
}

/// FULL: the entire commissionBasisAmount is used as-is (the sale is
/// assumed fully collectible, or collection status isn't tracked for
/// this basis). COLLECTED: prorates the basis to the percentage of the
/// underlying InstallmentSchedule actually paid-to-date at calculation
/// time (sum of InstallmentLine.amountPaid / InstallmentSchedule.
/// totalAmount) Ã¢â‚¬â€ the master prompt's own "partial-payment rules"
/// requirement. A sale with no InstallmentSchedule (cash sale) can only
/// use FULL Ã¢â‚¬â€ enforced by CommissionCalculationService, not a DB CHECK
/// constraint (see CommissionPlan's own top-of-section comment for why
/// this schema has no precedent for hand-written CHECK constraints).
enum CommissionCollectionBasis {
  FULL
  COLLECTED
}

/// CALCULATED is the only state a fresh calculation starts in.
/// Forward lifecycle (RE-COMM.3): CALCULATED -[submit]-> PENDING
/// -[approve]-> APPROVED -[markPayable]-> PAYABLE -[markPaid]-> PAID.
/// PENDING can also be -[reject]-> REJECTED (terminal Ã¢â‚¬â€ a distinct
/// outcome from CANCELLED: rejection means someone with approval
/// authority reviewed and declined it; a rejected calculation is
/// corrected via `adjust`, same as any other non-terminal state, not
/// resurrected). CANCELLED is used when a CALCULATED or PENDING row is
/// voided before ever being approved (e.g. duplicate calculation, wrong
/// plan resolved) Ã¢â‚¬â€ CommissionCalculationService's own `cancel` no
/// longer accepts APPROVED/PAYABLE/PAID; `reverse` is the only path out
/// of those. REVERSED is used at any non-terminal state (including
/// PAID Ã¢â‚¬â€ a clawback of an already-paid commission is a real business
/// need `reverse` deliberately still allows) when the calculation
/// itself was wrong or the underlying sale was reversed/cancelled after
/// the fact Ã¢â‚¬â€ the row is kept, never deleted, for audit trail, matching
/// AgentAssignment's own "ended, not deleted" convention. REJECTED,
/// CANCELLED, and REVERSED are all terminal Ã¢â‚¬â€ enforced by
/// CommissionCalculationService's own guarded transition methods, never
/// a direct `status` field update, the same "reject, don't silently
/// ignore" discipline AgentService's own lifecycle methods already
/// established. `adjust` (RE-COMM.3's own "Adjustment" requirement) is
/// not a status of its own Ã¢â‚¬â€ it atomically reverses an existing
/// non-terminal row and creates a fresh one linked via
/// `supersedesCalculationId`, the same "new row, not an in-place edit"
/// discipline `calculate`'s own recalculation-after-terminal path
/// already established, just wrapped in one transaction instead of two
/// separate calls.
enum CommissionCalculationStatus {
  CALCULATED
  PENDING
  APPROVED
  PAYABLE
  PAID
  REJECTED
  REVERSED
  CANCELLED
}

model CommissionCalculation {
  id       String @id @default(uuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  // The agent and the specific assignment this calculation is for.
  // agentAssignmentId's own `role` (PRIMARY/CO_AGENT/REFERRAL) at the
  // time of calculation is snapshotted into `role` below rather than
  // re-read live, since an assignment's role never changes after create
  // (AgentAssignmentService only ever ends an assignment, never edits
  // its role) but snapshotting keeps this row self-describing without a
  // join. agentAssignment.scope must be SALE (allocationId populated) Ã¢â‚¬â€
  // a PROJECT- or UNIT-scoped assignment has no specific sale yet to
  // calculate a commission against; enforced by
  // CommissionCalculationService, not a DB CHECK.
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  agentAssignmentId String
  agentAssignment   AgentAssignment     @relation(fields: [agentAssignmentId], references: [id], onDelete: Restrict)
  role              AgentAssignmentRole

  // The underlying property transaction Ã¢â‚¬â€ the master prompt's own
  // explicit traceability requirement. Always agentAssignment's own
  // allocationId, re-validated (not just trusted) at calculation time Ã¢â‚¬â€
  // same "resolve server-side, never take the caller's word for it"
  // discipline AgentAssignment.entityId's own doc comment already
  // established.
  allocationId String
  allocation   UnitSaleAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  // The plan resolved via CommissionPlanService.resolvePlan() at
  // calculation time (UNIT > PROJECT > ESTATE > AGENT > GLOBAL,
  // filtered to isReferral matching `role === REFERRAL`) Ã¢â‚¬â€ kept as a
  // live FK for traceability/reporting joins, but every number the plan
  // supplied is separately snapshotted below so a later edit to the
  // plan itself never changes this row's own amounts.
  commissionPlanId String
  commissionPlan   CommissionPlan @relation(fields: [commissionPlanId], references: [id], onDelete: Restrict)
  planType         CommissionPlanType
  planWasTiered    Boolean
  tierOrderApplied Int?
  rateApplied      Decimal? @db.Decimal(9, 4)
  fixedAmountApplied Decimal? @db.Decimal(18, 2)

  // Basis (gross/net sale value, discount handling).
  basisType      CommissionBasisType
  grossSaleValue Decimal @db.Decimal(18, 2) // snapshot of allocation.salePrice
  discountAmount Decimal @db.Decimal(18, 2) @default(0)
  netSaleValue   Decimal @db.Decimal(18, 2) // grossSaleValue - discountAmount
  // Whichever of grossSaleValue/netSaleValue basisType selects Ã¢â‚¬â€ the
  // amount a flat-rate plan's `rate`/`fixedAmount` (or a tiered plan's
  // tier lookup) is actually applied against, before any collection
  // proration below.
  commissionBasisAmount Decimal @db.Decimal(18, 2)

  // Partial-payment rules.
  collectionBasis      CommissionCollectionBasis @default(FULL)
  collectedAmount      Decimal? @db.Decimal(18, 2)
  collectedPercent     Decimal? @db.Decimal(7, 4) // 0..1, e.g. 0.4500 = 45% collected
  // commissionBasisAmount unchanged if FULL; commissionBasisAmount *
  // collectedPercent if COLLECTED Ã¢â‚¬â€ this is the amount the rate/tier
  // lookup and the resulting grossCommission are actually computed
  // from.
  proratedBasisAmount Decimal @db.Decimal(18, 2)

  grossCommission Decimal @db.Decimal(18, 2)

  // Tax/WHT deductions where applicable Ã¢â‚¬â€ reads Agent.
  // withholdingTaxExempt first; if not exempt, the caller supplies a
  // TaxCode id (looked up and snapshotted here, same
  // resolve-once-then-snapshot pattern AccountsPayableService already
  // uses for whtTaxCodeId/vatTaxCodeId Ã¢â‚¬â€ see this section's own top
  // comment). All four fields stay null/false/0 when exempt or when no
  // taxCodeId was supplied.
  whtApplied            Boolean  @default(false)
  whtRate               Decimal? @db.Decimal(6, 4)
  whtAmount             Decimal  @db.Decimal(18, 2) @default(0)
  whtAuthorityAccountId String?
  whtAuthorityAccount   Account? @relation("CommissionCalculationWhtAuthorityAccount", fields: [whtAuthorityAccountId], references: [id], onDelete: Restrict)

  // grossCommission - whtAmount. The amount that will eventually be
  // payable to the agent once RE-COMM.3's own lifecycle/RE-COMM.4's own
  // PostingEngineService integration exist Ã¢â‚¬â€ this checkpoint computes
  // and stores the number only, does not post or pay it.
  netCommission Decimal @db.Decimal(18, 2)

  status CommissionCalculationStatus @default(CALCULATED)

  calculatedById String
  calculatedAt   DateTime @default(now())
  calculatedBy   User     @relation("CommissionCalculationCalculatedBy", fields: [calculatedById], references: [id], onDelete: Restrict)

  // Cancellation/reversal handling Ã¢â‚¬â€ see CommissionCalculationStatus's
  // own doc comment for the distinction between the two.
  reversedById  String?
  reversedAt    DateTime?
  reverseReason String?
  reversedBy    User?     @relation("CommissionCalculationReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledBy    User?     @relation("CommissionCalculationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  // Forward approval/payment lifecycle (RE-COMM.3) Ã¢â‚¬â€ see
  // CommissionCalculationStatus's own doc comment for the full
  // transition graph. Each column pair is populated only by its own
  // CommissionCalculationService method, never directly.
  submittedById String?
  submittedAt   DateTime?
  submittedBy   User?     @relation("CommissionCalculationSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedAt   DateTime?
  approvedBy   User?     @relation("CommissionCalculationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  rejectedById String?
  rejectedAt   DateTime?
  rejectReason String?
  rejectedBy   User?     @relation("CommissionCalculationRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  markedPayableById String?
  markedPayableAt   DateTime?
  markedPayableBy   User?     @relation("CommissionCalculationMarkedPayableBy", fields: [markedPayableById], references: [id], onDelete: Restrict)

  // RE-COMM.4 Ã¢â‚¬â€ Financial Integration. Posted through the existing
  // PostingEngineService.postSystemEntry (see AccountsPayableService.
  // postInvoice's own accrual/clearing pair for the analogue this
  // reuses) Ã¢â‚¬â€ no separate accounting engine. `payableAccountId` is
  // captured here at markPayable() time from the caller-supplied DTO
  // and reused, not re-asked, at markPaid() time, so the clearing leg
  // can never book against a different payable account than the
  // accrual leg credited. `journalEntryId` traces each of the two
  // postings back to its own JournalEntry Ã¢â‚¬â€ the calculation itself was
  // already traceable to the underlying sale via `allocationId`
  // (RE-COMM.2); this adds the other side of that trail, from the
  // commission out to the ledger. WHT (`whtAuthorityAccountId`,
  // already stored from RE-COMM.2) is credited in the SAME accrual
  // entry markPayable() posts Ã¢â‚¬â€ a real WHTDeduction/remittance
  // workflow integration is a further, separate future step, not
  // required for the entry itself to be correct and balanced today.
  payableAccountId      String?
  payableAccount        Account?     @relation("CommissionCalculationPayableAccount", fields: [payableAccountId], references: [id], onDelete: Restrict)
  payableJournalEntryId String?
  payableJournalEntry   JournalEntry? @relation("CommissionCalculationPayableJournalEntry", fields: [payableJournalEntryId], references: [id], onDelete: Restrict)
  paymentJournalEntryId String?
  paymentJournalEntry   JournalEntry? @relation("CommissionCalculationPaymentJournalEntry", fields: [paymentJournalEntryId], references: [id], onDelete: Restrict)

  /// Free-text bank transfer/cheque/payment-run reference Ã¢â‚¬â€ reconciliation
  /// detail only, independent of `paymentJournalEntryId` above (which is
  /// this system's own posted JournalEntry, not an external bank record).
  paymentReference String?
  paidById         String?
  paidAt           DateTime?
  paidBy           User?     @relation("CommissionCalculationPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  /// Set only on the NEW row `adjust()` creates, pointing back at the row
  /// it superseded (which `adjust()` reverses in the same transaction).
  /// See CommissionCalculationStatus's own doc comment for why this is
  /// not a status of its own.
  supersedesCalculationId String?                  @unique
  supersedesCalculation   CommissionCalculation?   @relation("CommissionCalculationSupersedes", fields: [supersedesCalculationId], references: [id], onDelete: Restrict)
  supersededBy            CommissionCalculation?   @relation("CommissionCalculationSupersedes")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId])
  @@index([agentId])
  @@index([agentAssignmentId])
  @@index([allocationId])
  @@index([commissionPlanId])
  @@index([status])
  @@map("commission_calculations")
}
