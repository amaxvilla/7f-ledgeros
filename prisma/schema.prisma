//
// DELETION POLICY (enforced per-relation below):
// This is a financial ERP Ã¢â‚¬â€ financial and operational history must never
// be deleted automatically via a cascading foreign key. Every relation
// in this schema uses `onDelete: Restrict` unless it is explicitly
// justified otherwise in an inline comment directly above it.
// `onDelete: Cascade` is reserved for records with zero independent or
// historical meaning of their own (pure join/config/session rows) Ã¢â‚¬â€ see
// the justification comment above each of the ~12 relations that use it.
// Do not add a new Cascade relation without the same kind of comment.
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

