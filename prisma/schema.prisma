  salaryStructures     SalaryStructure[]
  payrollRuns          PayrollRun[]
  incidentReports      IncidentReport[]
  nearMisses           NearMiss[]
  ppeIssuances         PpeIssuance[]
  toolboxTalks         ToolboxTalk[]
  inspectionChecklists InspectionChecklist[]
  budgets              Budget[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  procurementGRNs      ProcurementGRN[]
  vendorInvoices       VendorInvoice[]
  vendorLedgerEntries  VendorLedger[]
  paymentBatches       PaymentBatch[]
  paymentVouchers      PaymentVoucher[]
  whtDeductions        WHTDeduction[]
  vatDeductions        VATDeduction[]
  arInvoices           ARInvoice[]
  receipts             Receipt[]
  customerLedgerEntries CustomerLedger[]
  bankStatements       BankStatement[]
  reconciliationSessions ReconciliationSession[]

  brandingProfile   EntityBrandingProfile?
  brandAssets       BrandAsset[]
  documentTemplates DocumentTemplate[]
  entityProfile     EntityProfile?

  // Release (Fixed Assets Core, additive)
  fixedAssets       FixedAsset[]

  // Release IA Ã¢â‚¬â€ Core Integration Framework (additive)
  integrationProviders IntegrationProvider[]
  // Release IE.1 Checkpoint C (additive)
  paymentTransactions  PaymentTransaction[]
  // Transfer APIs, Checkpoint B (additive)
  bankTransfers        BankTransfer[]
  // API Gateway, Checkpoint A (additive)
  apiKeys              ApiKey[]
