    "@bull-board/api": "^5.21.0",
    "@bull-board/express": "^5.21.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^4.1.0",
    "@prisma/client": "^5.16.1",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
