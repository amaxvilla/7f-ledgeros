# 7F LedgerOS — environment configuration
#
# Copy this file to .env and fill in the placeholders. Every variable
# here is documented in docs/environment-configuration.md — see that
# file for which app reads each one, whether it's required, and what
# happens if it's left unset.
#
# Values shown as CHANGE_ME are real, insecure, checked-in placeholders
# in docker-compose.yml's own defaults — replace them before any
# non-local deployment.

# ---- Core / Database ----
DATABASE_URL=postgresql://ledgeros:change_me_locally@localhost:5432/ledgeros?schema=public
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ---- Authentication ----
# Required in production — the app refuses to start in NODE_ENV=production
# without this set. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_SERVICE_TOKEN=CHANGE_ME
WORKER_SERVICE_USER_EMAIL=worker-service@7fifteencapital.com

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---- Worker / Queue ----
INTERNAL_API_BASE_URL=http://localhost:4000/api/v1
QUEUE_DASHBOARD_ENABLED=true
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@7fifteencapital.com

# ---- Third-party integrations (Release IA provider registry) ----
# Required if ANY integration below is used — decrypts every provider's
# stored credential row.
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME

POWER_BI_PROVIDER_ID=
BANK_MONO_PROVIDER_ID=
EMAIL_SMTP_PROVIDER_ID=
PAYMENT_FLUTTERWAVE_PROVIDER_ID=
PAYMENT_PAYSTACK_PROVIDER_ID=
SIGNATURE_ADOBE_SIGN_PROVIDER_ID=
SIGNATURE_DOCUSIGN_PROVIDER_ID=
SMS_TWILIO_PROVIDER_ID=
WHATSAPP_CLOUD_PROVIDER_ID=
STORAGE_DRIVE_PROVIDER_ID=
STORAGE_S3_PROVIDER_ID=
WORKSPACE_ADMIN_PROVIDER_ID=

# Read directly by their own driver, not via the provider-id/registry path
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TWILIO_WEBHOOK_URL=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# ---- Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ---- Docker Compose only (container config, not read by application code) ----
POSTGRES_USER=ledgeros
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ledgeros
POSTGRES_PORT=5432
REDIS_PORT=6379
WORKER_HTTP_PORT=4100
WEB_PORT=3000
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# Optional — off-host backup storage. If set, scripts/backup.sh uploads each
# dump to this S3 bucket via the aws CLI (not installed by the backup
# service's own image; see docs/environment-configuration.md). Also needs
# AWS credentials in this file (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# if set — not 7F LedgerOS-specific variables, so not templated here.
# BACKUP_S3_BUCKET=
