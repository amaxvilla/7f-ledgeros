model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  // Release ID Ã¢â‚¬â€ SMS Integration (Twilio). Optional Ã¢â‚¬â€ SMS notifications for
  // a user with no phone set are logged and marked FAILED with a clear
  // reason rather than silently dropped or blocking the notification queue.
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Release J Ã¢â‚¬â€ Security Hardening Part 1 (additive)
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Release M Ã¢â‚¬â€ MFA / TOTP (additive). mfaSecret is the base32 TOTP
  // seed. KNOWN LIMITATION: stored as plain text, not encrypted at
  // rest Ã¢â‚¬â€ this repo has no KMS/envelope-encryption utility yet for
  // application-level secrets (distinct from passwordHash, which is a
  // one-way bcrypt hash and doesn't need one). Flagged explicitly in
  // the release report rather than silently accepted.
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaEnrolledAt  DateTime?
  mfaRecoveryCodes MfaRecoveryCode[]

  roles         UserRole[]
  entityAccess  UserEntityAccess[]
  departmentAccess  UserDepartmentAccess[]
  costCenterAccess  UserCostCenterAccess[]
  projectAccess     UserProjectAccess[]
  businessUnitAccess UserBusinessUnitAccess[]
  journalEntriesCreated  JournalEntry[] @relation("JournalCreatedBy")
  journalEntriesApproved JournalEntry[] @relation("JournalApprovedBy")
  journalEntriesPosted   JournalEntry[] @relation("JournalPostedBy")
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  trustedDevices TrustedDevice[]
  ipAllowlistRules        IpAllowlistRule[] @relation("IpAllowlistRuleUser")
  ipAllowlistRulesCreated IpAllowlistRule[] @relation("IpAllowlistRuleCreatedBy")
  ifrsNoteDisclosuresUpdated IfrsNoteDisclosure[]
  requisitionsRequested JobRequisition[] @relation("RequisitionRequestedBy")
  requisitionsApproved  JobRequisition[] @relation("RequisitionApprovedBy")
  offersCreated         Offer[]          @relation("OfferCreatedBy")
  backgroundChecksInitiated BackgroundCheck[]
  assignedCorrectiveActions CorrectiveAction[]

  // Phase 4 Ã¢â‚¬â€ Property Sales completion (additive)
  reservationsCreated    UnitReservation[]     @relation("ReservationCreatedBy")
  reservationsCancelled  UnitReservation[]     @relation("ReservationCancelledBy")
  allocationsCancelled   UnitSaleAllocation[]  @relation("AllocationCancelledBy")
  allocationEventsCreated UnitAllocationEvent[] @relation("AllocationEventCreatedBy")

  employeeProfile Employee?

  budgetsCreated          Budget[]             @relation("BudgetCreatedBy")
  budgetsApproved         Budget[]             @relation("BudgetApprovedBy")
  budgetRevisionsCreated  BudgetRevision[]     @relation("BudgetRevisionCreatedBy")
  budgetRevisionsApproved BudgetRevision[]     @relation("BudgetRevisionApprovedBy")
  budgetTransfersCreated  BudgetTransfer[]     @relation("BudgetTransferCreatedBy")
  budgetTransfersApproved BudgetTransfer[]     @relation("BudgetTransferApprovedBy")
  budgetApprovalActions   BudgetApproval[]     @relation("BudgetApprovalActor")
  budgetCommitmentsCreated BudgetCommitment[]  @relation("BudgetCommitmentCreatedBy")

  prsRequested          PurchaseRequisition[] @relation("PRRequestedBy")
  prsApproved           PurchaseRequisition[] @relation("PRApprovedBy")
  posCreated            PurchaseOrder[]       @relation("POCreatedBy")
  posApproved           PurchaseOrder[]       @relation("POApprovedBy")
  procurementGRNsCreated ProcurementGRN[]      @relation("ProcurementGRNCreatedBy")
  vendorInvoicesCreated VendorInvoice[]        @relation("VendorInvoiceCreatedBy")
  threeWayMatchesActioned ThreeWayMatch[]      @relation("ThreeWayMatchMatchedBy")

  paymentBatchesCreated   PaymentBatch[]   @relation("PaymentBatchCreatedBy")
  paymentBatchesApproved  PaymentBatch[]   @relation("PaymentBatchApprovedBy")
  paymentVouchersCreated  PaymentVoucher[] @relation("PaymentVoucherCreatedBy")
  paymentVouchersApproved PaymentVoucher[] @relation("PaymentVoucherApprovedBy")

  arInvoicesCreated ARInvoice[] @relation("ARInvoiceCreatedBy")
  receiptsCreated   Receipt[]   @relation("ReceiptCreatedBy")

  bankStatementsImported        BankStatement[]          @relation("BankStatementImportedBy")
  reconciliationSessionsCreated ReconciliationSession[]   @relation("ReconciliationSessionCreatedBy")
  reconciliationSessionsApproved ReconciliationSession[]  @relation("ReconciliationSessionApprovedBy")
  reconciliationMatchesCreated  ReconciliationMatch[]     @relation("ReconciliationMatchCreatedBy")

  workflowInstancesStarted WorkflowInstance[] @relation("WorkflowInstanceStartedBy")
  workflowActionsTaken     WorkflowAction[]   @relation("WorkflowActionActor")

  brandAssetsUploaded     BrandAsset[]       @relation("BrandAssetUploadedBy")
  documentTemplatesCreated DocumentTemplate[] @relation("DocumentTemplateCreatedBy")
  preference               UserPreference?
  notifications            Notification[]

  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive)
  leadsAssigned         Lead[]        @relation("LeadAssignedTo")
  leadsCreated          Lead[]        @relation("LeadCreatedBy")
  prospectsAssigned     Prospect[]    @relation("ProspectAssignedTo")
  prospectsCreated      Prospect[]    @relation("ProspectCreatedBy")
  crmActivitiesCreated  CrmActivity[] @relation("CrmActivityCreatedBy")

  // Phase 5A Ã¢â‚¬â€ Mortgage Management / Handover Workflow / Snag Lists (additive)
  mortgageApplicationsCreated MortgageApplication[] @relation("MortgageCreatedBy")
  handoverRecordsCreated      HandoverRecord[]     @relation("HandoverCreatedBy")
  handoverRecordsHandedOver   HandoverRecord[]     @relation("HandoverHandedOverBy")
  snagsReported               SnagItem[]           @relation("SnagReportedBy")
  snagsAssigned                SnagItem[]           @relation("SnagAssignedTo")
  snagsVerified                SnagItem[]           @relation("SnagVerifiedBy")

  // Phase 5A Ã¢â‚¬â€ Tenant / Lease Management (additive)
  tenantsCreated   Tenant[] @relation("TenantCreatedBy")
  leasesCreated    Lease[]  @relation("LeaseCreatedBy")

  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive)
  facilitiesCreated           Facility[]            @relation("FacilityCreatedBy")
  maintenanceRequestsReported MaintenanceRequest[]   @relation("MaintenanceReportedBy")

  // Release (Fixed Assets Core, additive)
  assetsDisposed AssetDisposal[] @relation("AssetDisposedBy")

  // Release H (PMO Scheduling Core, additive)
  projectTasksCreated ProjectTask[] @relation("ProjectTaskCreatedBy")

  // Release I (PMO Risk & Issue Management, additive)
  risksOwned      ProjectRisk[]  @relation("RiskOwner")
  risksIdentified ProjectRisk[]  @relation("RiskIdentifiedBy")
  issuesAssigned  ProjectIssue[] @relation("IssueAssignedTo")
  issuesRaised    ProjectIssue[] @relation("IssueRaisedBy")

  // Release J (PMO Resource & Equipment/Labour Allocation, additive)
  resourcesCreated           ProjectResource[]     @relation("ResourceCreatedBy")
  resourceAllocationsCreated ResourceAllocation[]  @relation("ResourceAllocationCreatedBy")

  // Release K (Security Hardening Part 1, additive)
  passwordHistory           PasswordHistory[]      @relation("PasswordHistoryUser")
  loginHistory              LoginHistory[]         @relation("LoginHistoryUser")
  authSecurityPoliciesCreated AuthSecurityPolicy[] @relation("AuthSecurityPolicyCreatedBy")

  // Release IA (Core Integration Framework, additive)
  integrationProvidersCreated IntegrationProvider[] @relation("IntegrationProviderCreatedBy")

  // Release IC.4 (Email Template Engine, additive)
  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  // Release IE.1 Checkpoint C (additive)
  paymentTransactionsCreated PaymentTransaction[] @relation("PaymentTransactionCreatedBy")
  paymentRefundsCreated      PaymentRefund[]      @relation("PaymentRefundCreatedBy")

  // Release IF.1, Checkpoint C (additive)
  monoLinkedAccountsLinked MonoLinkedAccount[] @relation("MonoLinkedAccountLinkedBy")

  // Transfer APIs, Checkpoint B (additive)
  bankTransfersInitiated BankTransfer[] @relation("BankTransferInitiatedBy")

  // API Gateway, Checkpoint A (additive)
  apiKeysCreated ApiKey[] @relation("ApiKeyCreatedBy")
  apiKeysRevoked ApiKey[] @relation("ApiKeyRevokedBy")

  // Agent Management, RE-AGENT.1 (additive)
  agentsCreated    Agent[] @relation("AgentCreatedBy")
  agentsApproved   Agent[] @relation("AgentApprovedBy")
  agentsSuspended  Agent[] @relation("AgentSuspendedBy")
  agentsTerminated Agent[] @relation("AgentTerminatedBy")
  // Agent & Commission Management, RE-AGENT.2 (additive)
  agentAssignmentsCreated AgentAssignment[] @relation("AgentAssignmentCreatedBy")
  agentAssignmentsEnded   AgentAssignment[] @relation("AgentAssignmentEndedBy")
  // Agent & Commission Management, RE-COMM.1 (additive)
  commissionPlansCreated    CommissionPlan[] @relation("CommissionPlanCreatedBy")
  commissionPlansDeactivated CommissionPlan[] @relation("CommissionPlanDeactivatedBy")
  // Agent & Commission Management, RE-COMM.2 (additive)
  commissionCalculationsCalculated CommissionCalculation[] @relation("CommissionCalculationCalculatedBy")
  commissionCalculationsReversed   CommissionCalculation[] @relation("CommissionCalculationReversedBy")
  commissionCalculationsCancelled  CommissionCalculation[] @relation("CommissionCalculationCancelledBy")
  // RE-COMM.3 (additive)
  commissionCalculationsSubmitted      CommissionCalculation[] @relation("CommissionCalculationSubmittedBy")
  commissionCalculationsApproved       CommissionCalculation[] @relation("CommissionCalculationApprovedBy")
  commissionCalculationsRejected       CommissionCalculation[] @relation("CommissionCalculationRejectedBy")
  commissionCalculationsMarkedPayable  CommissionCalculation[] @relation("CommissionCalculationMarkedPayableBy")
  commissionCalculationsPaid           CommissionCalculation[] @relation("CommissionCalculationPaidBy")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Release N Ã¢â‚¬â€ Session Management (additive). Each RefreshToken row IS
  // a session: it rotates on every /auth/refresh (old row revoked, new
  // row issued), so "list my active sessions" = "list my non-revoked,
  // non-expired RefreshToken rows" Ã¢â‚¬â€ a documented simplification, same
  // spirit as EVM's linear time-phasing: no separate Session model,
  // reusing what already 1:1 tracks a logged-in device.
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  lastUsedAt DateTime?

  // CASCADE justified: a session/refresh token has no value once its owning user is gone;
  // it is not financial or audit history.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedDevice TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

// =====================================================================
// RELEASE N Ã¢â‚¬â€ TRUSTED DEVICES (additive)
// =====================================================================
// A device a user has explicitly chosen to remember at the moment they
// complete an MFA challenge (VerifyMfaDto.rememberDevice = true). Its
// raw token is generated once, returned to the client to store (e.g. a
// long-lived cookie), and only its hash persisted Ã¢â‚¬â€ identical convention
// to RefreshToken.tokenHash and MfaRecoveryCode.codeHash. A subsequent
// login presenting a valid, unexpired, unrevoked trusted-device token
// skips the MFA challenge (AuthService.login), the same way "remember
// this device for 30 days" works in most consumer MFA flows.
model TrustedDevice {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  deviceName  String?
  ipAddress   String?
  userAgent   String?
  trustedAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime
  revoked     Boolean   @default(false)

  // CASCADE justified: identical reasoning to RefreshToken/MfaRecoveryCode
  // Ã¢â‚¬â€ a trusted-device record has no value once its owning user is gone.
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions RefreshToken[]

  @@index([userId])
  @@map("trusted_devices")
}

// =====================================================================
// RELEASE P Ã¢â‚¬â€ IP RESTRICTIONS (additive)
// =====================================================================
// Two scopes only: GLOBAL (applies to every user) and USER (applies to
// one specific account). An ENTITY scope was deliberately left out Ã¢â‚¬â€
// User has no single entityId (access is granted via UserEntityAccess
// and resolved into a multi-id SecurityScope by SecurityContextService),
// and IpRestrictionGuard runs on every authenticated request, so it
// can't afford a full buildScope() call just to find applicable IP
// rules. GLOBAL + USER covers the two real cases (an office/VPN
// allowlist for the whole org, and locking one sensitive account to
// known IPs) without that cost. Flagged as a scoping decision, not
// silently omitted Ã¢â‚¬â€ an ENTITY scope can be added later the same way
// RLS's own 'businessUnit' dimension was layered onto 'entity'.
//
// Fail-open-until-configured, fail-closed-once-configured Ã¢â‚¬â€ the same
// posture RowLevelSecurityService uses: a user/global with ZERO active
// rules is unrestricted; the moment at least one active rule applies,
// the request IP must match one of them.

enum IpRuleScope {
  GLOBAL
  USER
}

model IpAllowlistRule {
  id          String      @id @default(uuid())
  scope       IpRuleScope
  userId      String? // required when scope = USER, null when GLOBAL
  cidr        String // IPv4 only for now, e.g. "203.0.113.0/24" or "203.0.113.5/32"
  label       String?
  isActive    Boolean     @default(true)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User? @relation("IpAllowlistRuleUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("IpAllowlistRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([scope, isActive])
  @@index([userId])
  @@map("ip_allowlist_rules")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique // e.g. "gl.journal.post"
  module      String // e.g. "GL", "AR", "AP", "PMO"
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  // CASCADE justified: RBAC join row (role<->permission), pure authorization config.
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  // CASCADE justified: RBAC join row; deleting the user or role it links removes only the
  // assignment, not any financial or audit data.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Restricts which entities a user may see/post to (multi-entity RBAC)
model UserEntityAccess {
  userId   String
  entityId String
  canPost  Boolean @default(false)
  canView  Boolean @default(true)

  // CASCADE justified: an access grant record has no meaning once the user or entity it
  // grants access to/for is gone; it is not financial or audit history.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
  @@map("user_entity_access")
}

/// Phase 2 Ã¢â‚¬â€ Row Level Security (additive).
/// Restricts which departments a user may see/post to. Absence of any row
/// for a user is interpreted by SecurityContextService per its
/// `unrestrictedIfNoGrants` policy (see security module docs) Ã¢â‚¬â€ by default,
/// a user with zero rows here is treated as having full department access
/// within the entities they can already see (mirrors legacy pre-Phase-2
/// behavior). Once a user has at least one explicit grant, access is
/// restricted to only the granted departments.
model UserDepartmentAccess {
  userId       String
  departmentId String
  canPost      Boolean @default(false)
  canView      Boolean @default(true)

  // CASCADE justified: an access grant record has no meaning once the user or
  // department it grants access to/for is gone; it is not financial or audit history.
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_department_access")
}

/// Phase 2 Ã¢â‚¬â€ Row Level Security (additive). Same semantics as
/// UserDepartmentAccess, scoped to Cost Centres.
model UserCostCenterAccess {
  userId       String
  costCenterId String
  canPost      Boolean @default(false)
  canView      Boolean @default(true)

  // CASCADE justified: an access grant record has no meaning once the user or
  // cost centre it grants access to/for is gone; it is not financial or audit history.
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@id([userId, costCenterId])
  @@map("user_cost_center_access")
}

/// Phase 2 Ã¢â‚¬â€ Row Level Security (additive). Same semantics as
/// UserDepartmentAccess, scoped to Projects. Covers Budget, PMO,
/// Procurement, Inventory, Real Estate and Reporting access as required.
model UserProjectAccess {
  userId    String
  projectId String
  canPost   Boolean @default(false)
  canView   Boolean @default(true)

  // CASCADE justified: an access grant record has no meaning once the user or
  // project it grants access to/for is gone; it is not financial or audit history.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("user_project_access")
}

/// Phase 2 Ã¢â‚¬â€ Row Level Security (additive). Groups Entities under a
/// Business Unit for a fifth, coarser-grained RLS dimension (section 5).
/// `businessUnitId` on Entity is nullable so existing entities are
/// unaffected until an admin assigns them; unassigned entities are simply
/// not reachable through business-unit-scoped access (they remain fully
/// reachable through the existing entity/department/cost-centre/project
/// dimensions, which are unchanged).
model BusinessUnit {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities   Entity[]
  userAccess UserBusinessUnitAccess[]

  @@map("business_units")
}

/// Phase 2 Ã¢â‚¬â€ Row Level Security (additive). Same semantics as
/// UserDepartmentAccess/UserCostCenterAccess/UserProjectAccess, scoped to
/// Business Units. Resolved by SecurityContextService into the set of
/// Entity ids under the granted Business Units, then intersected into the
/// existing `entity` DimensionScope Ã¢â‚¬â€ no new Prisma field is added to
/// transactional tables, so RowLevelSecurityService.buildWhere() keeps
/// working unchanged for every model that already declares the `entity`
/// dimension.
model UserBusinessUnitAccess {
  userId         String
  businessUnitId String
  canPost        Boolean @default(false)
  canView        Boolean @default(true)

  // CASCADE justified: an access grant record has no meaning once the user or
  // business unit it grants access to/for is gone; it is not financial or audit history.
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([userId, businessUnitId])
  @@map("user_business_unit_access")
}

// =====================================================================
// ENTITY MANAGEMENT
// =====================================================================

model Entity {
  id              String   @id @default(uuid())
  code            String   @unique // e.g. "7FC", "7FIL", "ZURII"
  name            String
  legalName       String
  taxIdentificationNumber String?
  registrationNumber      String?
  baseCurrency    String   @default("NGN")
  fiscalYearStartMonth Int @default(1) // 1-12
  isActive        Boolean  @default(true)
  isConsolidationParent Boolean @default(false)

  // Phase 2 Ã¢â‚¬â€ Row Level Security (additive, nullable): optional grouping
  // under a Business Unit. See BusinessUnit doc comment.
  businessUnitId  String?
  businessUnit    BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  parentEntityId  String?
  parentEntity    Entity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: Restrict)
  subsidiaries    Entity[] @relation("EntityHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountActivations EntityAccount[]
  estates              Estate[]
  landParcels          LandParcel[]
  unitReservations     UnitReservation[]
  projects            Project[]
  // Phase 5A Ã¢â‚¬â€ CRM / Lead Management (additive)
  crmLeads             Lead[]
  crmProspects         Prospect[]
  // Phase 5A Ã¢â‚¬â€ Mortgage Management (additive)
  mortgageApplications MortgageApplication[]
  // Phase 5A Ã¢â‚¬â€ Handover Workflow (additive)
  handoverRecords      HandoverRecord[]
  // Phase 5A Ã¢â‚¬â€ Tenant / Lease Management (additive)
  tenants              Tenant[]
  leases               Lease[]
  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive)
  facilities           Facility[]
  maintenanceRequests  MaintenanceRequest[]
  // Release H (PMO Scheduling Core, additive)
  projectTasks         ProjectTask[]
  // Release I (PMO Risk & Issue Management, additive)
  projectRisks         ProjectRisk[]
  projectIssues        ProjectIssue[]
  // Release J (PMO Resource & Equipment/Labour Allocation, additive)
  projectResources     ProjectResource[]
  resourceAllocations  ResourceAllocation[]
  // Release K (Security Hardening Part 1, additive)
  authSecurityPolicies AuthSecurityPolicy[]
  jobRequisitions     JobRequisition[]
  vacancies           Vacancy[]
  performanceCycles   PerformanceCycle[]
  trainingCourses     TrainingCourse[]
  ifrsNoteDisclosures IfrsNoteDisclosure[]
  successionPlans     SuccessionPlan[]
  departments          Department[]
  costCenters          CostCenter[]
  fundingSources       FundingSource[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  fiscalPeriods        FiscalPeriod[]
  journalNumberSequences JournalNumberSequence[]
