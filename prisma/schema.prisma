// =====================================================================
// BUDGETING & BUDGET CONTROL
// =====================================================================

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FROZEN
  CLOSED
}

enum BudgetRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BudgetTransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// Append-only log of every workflow action taken against a Budget Ã¢â‚¬â€
/// the audit trail backing the approval workflow (mirrors how AuditLog
/// backs the GL kernel, but scoped and queryable per-budget).
enum BudgetApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  FROZEN
  REVISED
  TRANSFERRED
  REOPENED
  CLOSED
}

enum BudgetCommitmentSourceType {
  PURCHASE_ORDER
  MANUAL
}

enum BudgetCommitmentStatus {
  OPEN
  PARTIALLY_RELEASED
  RELEASED
  CANCELLED
}

/// The budget "envelope" for one entity/fiscal year. Holds the original
/// approved plan; in-year changes are tracked separately via
/// BudgetRevision (re-baselining) and BudgetTransfer (moving amounts
/// between cost centers without changing the total).
model Budget {
  id          String       @id @default(uuid())
  entityId    String
  code        String
  name        String
  fiscalYear  Int
  status      BudgetStatus @default(DRAFT)
  description String?

  createdById  String
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  frozenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity     Entity  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("BudgetApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  lines     BudgetLine[]
  revisions BudgetRevision[]
  transfers BudgetTransfer[]
  approvals BudgetApproval[]

  @@unique([entityId, code])
  @@index([entityId, fiscalYear])
  @@map("budgets")
}

/// The atomic budget cell: one account Ãƒâ€” one dimension combination Ãƒâ€” one
/// month. `originalAmount` never changes after approval; `revisedAmount`
/// is the amount BudgetRevision/BudgetTransfer actions maintain and is
/// what variance/availability calculations use going forward.
model BudgetLine {
  id              String  @id @default(uuid())
  budgetId        String
  accountId       String
  projectId       String?
  phaseId         String?
  departmentId    String?
  costCenterId    String?
  fundingSourceId String?
  period          Int     // fiscal month, 1-12

  originalAmount Decimal @db.Decimal(18, 2)
  revisedAmount  Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase         Phase?         @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter    CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  fundingSource FundingSource? @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)

  commitments      BudgetCommitment[]
  revisionEntries  BudgetRevisionLine[]
  transfersFrom    BudgetTransfer[]     @relation("TransferFromLine")
  transfersTo      BudgetTransfer[]     @relation("TransferToLine")
  purchaseRequisitionLines PurchaseRequisitionLine[]
  jobRequisitions          JobRequisition[]
  purchaseOrderLines       PurchaseOrderLine[]

  @@index([budgetId])
  @@index([accountId])
  @@index([projectId])
  @@index([phaseId])
  @@index([departmentId])
  @@index([costCenterId])
  @@index([budgetId, period])
  @@map("budget_lines")
}

/// A re-baselining event for a budget: captures the reason and every
/// line-level before/after amount in one versioned package that goes
/// through its own submit/approve cycle before revisedAmount changes
/// on the underlying BudgetLine rows.
model BudgetRevision {
  id             String               @id @default(uuid())
  budgetId       String
  revisionNumber Int
  reason         String
  status         BudgetRevisionStatus @default(DRAFT)

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  budget     Budget               @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation("BudgetRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?                @relation("BudgetRevisionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines      BudgetRevisionLine[]

  @@unique([budgetId, revisionNumber])
  @@map("budget_revisions")
}

model BudgetRevisionLine {
  id               String @id @default(uuid())
  budgetRevisionId String
  budgetLineId     String
  previousAmount   Decimal @db.Decimal(18, 2)
  newAmount        Decimal @db.Decimal(18, 2)

  budgetRevision BudgetRevision @relation(fields: [budgetRevisionId], references: [id], onDelete: Restrict)
  budgetLine     BudgetLine     @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)

  @@index([budgetRevisionId])
  @@index([budgetLineId])
  @@map("budget_revision_lines")
}

/// Moves revisedAmount between two BudgetLines of the same Budget
/// without changing the budget's total Ã¢â‚¬â€ e.g. reallocating cost-center
/// spend within an approved envelope.
model BudgetTransfer {
  id       String                @id @default(uuid())
  budgetId String
  fromLineId String
  toLineId   String
  amount     Decimal             @db.Decimal(18, 2)
  reason     String
  status     BudgetTransferStatus @default(DRAFT)

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  budget     Budget     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  fromLine   BudgetLine @relation("TransferFromLine", fields: [fromLineId], references: [id], onDelete: Restrict)
  toLine     BudgetLine @relation("TransferToLine", fields: [toLineId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("BudgetTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?      @relation("BudgetTransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@map("budget_transfers")
}

/// Append-only workflow audit trail for a Budget (who did what, when).
model BudgetApproval {
  id       String               @id @default(uuid())
  budgetId String
  action   BudgetApprovalAction
  actorId  String
  comments String?

  createdAt DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  actor  User   @relation("BudgetApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@map("budget_approvals")
}

/// Reserves budget against a BudgetLine ahead of actual spend Ã¢â‚¬â€ created
/// when a purchase order is approved (Procurement phase) and released
/// (partially or fully) as goods/invoices are posted. `sourceId` is a
/// loose reference (not an FK) so this model has no dependency on the
/// Procurement schema landing first.
model BudgetCommitment {
  id             String                      @id @default(uuid())
  budgetLineId   String
  sourceType     BudgetCommitmentSourceType  @default(MANUAL)
  sourceId       String?
  amount         Decimal                     @db.Decimal(18, 2)
  releasedAmount Decimal                     @db.Decimal(18, 2) @default(0)
  status         BudgetCommitmentStatus      @default(OPEN)
  description    String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("BudgetCommitmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  purchaseOrderLine PurchaseOrderLine?

  @@index([budgetLineId])
  @@index([sourceType, sourceId])
  @@map("budget_commitments")
}

// =====================================================================
// PROCUREMENT (Phase Ã¢â‚¬â€ Procurement, AP/AR, Bank Recon & Dashboard update)
// Workflow: PR -> Approval -> PO -> GRN -> Vendor Invoice -> 3-Way Match
//           -> AP Voucher. Integrates with Budgeting (BudgetCommitment,
//           already defined above) and Inventory (StockMovement /
//           StockBalance, via InventoryService Ã¢â‚¬â€ not duplicated here).
// =====================================================================

enum PRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  PARTIALLY_INVOICED
  FULLY_INVOICED
  CLOSED
  CANCELLED
}

enum ProcurementGRNStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum VendorInvoiceStatus {
  DRAFT
  PENDING_MATCH
  MATCHED
  MATCHED_WITH_VARIANCE
  POSTED
  CANCELLED
}

enum ThreeWayMatchStatus {
  PENDING
  MATCHED
  MATCHED_WITH_VARIANCE
  EXCEPTION
}

/// A department/site request to buy something. Carries no GL/budget
/// commitment itself Ã¢â‚¬â€ that only happens once it becomes an approved PO.
model PurchaseRequisition {
  id             String    @id @default(uuid())
  entityId       String
  prNumber       String
  requestedById  String
  projectId      String?
  departmentId   String?
  costCenterId   String?
  fundingSourceId String?
  justification  String?
  status         PRStatus  @default(DRAFT)

  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity        Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  requestedBy   User            @relation("PRRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?           @relation("PRApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  department    Department?     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter    CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  fundingSource FundingSource?  @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)

  lines         PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([entityId, prNumber])
  @@index([entityId, status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id              String   @id @default(uuid())
  requisitionId   String
  description     String
  accountId       String
  budgetLineId    String?
  quantity        Decimal  @db.Decimal(18, 4)
  estimatedUnitCost Decimal @db.Decimal(18, 2)
  projectId       String?
  phaseId         String?
  departmentId    String?
  costCenterId    String?
  fundingSourceId String?

  createdAt DateTime @default(now())

  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  budgetLine    BudgetLine?         @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase         Phase?              @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter    CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  fundingSource FundingSource?      @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)

  purchaseOrderLines PurchaseOrderLine[]

  @@index([requisitionId])
  @@index([budgetLineId])
  @@map("purchase_requisition_lines")
}

/// The commercial commitment to a vendor. Approval is where budget
/// availability (Budget - Actual - Commitments) is checked and a
/// BudgetCommitment is raised per line via BudgetingService.
model PurchaseOrder {
  id              String   @id @default(uuid())
  entityId        String
  poNumber        String
  requisitionId   String?
  vendorId        String
  status          POStatus @default(DRAFT)
  orderDate       DateTime

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity      Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  vendor      Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?                @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  lines           PurchaseOrderLine[]
  goodsReceipts   ProcurementGRN[]
  vendorInvoices  VendorInvoice[]
  threeWayMatches ThreeWayMatch[]

  @@unique([entityId, poNumber])
  @@index([entityId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                 String  @id @default(uuid())
  purchaseOrderId    String
  requisitionLineId  String?
  description        String
  accountId          String
  stockItemId        String?
  quantity           Decimal @db.Decimal(18, 4)
  unitCost           Decimal @db.Decimal(18, 2)
  quantityReceived   Decimal @db.Decimal(18, 4) @default(0)
  quantityInvoiced   Decimal @db.Decimal(18, 4) @default(0)

  budgetLineId       String
  budgetCommitmentId String? @unique

  projectId       String?
  phaseId         String?
  departmentId    String?
  costCenterId    String?
  fundingSourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder    PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  requisitionLine  PurchaseRequisitionLine?  @relation(fields: [requisitionLineId], references: [id], onDelete: Restrict)
  account          Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  stockItem        StockItem?                @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  budgetLine       BudgetLine                @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  budgetCommitment BudgetCommitment?         @relation(fields: [budgetCommitmentId], references: [id], onDelete: Restrict)
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase            Phase?                    @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  department       Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter       CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  fundingSource    FundingSource?            @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)

  grnLines           ProcurementGRNLine[]
  vendorInvoiceLines VendorInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([budgetLineId])
  @@map("purchase_order_lines")
}

/// Vendor delivery against a PO. Deliberately named ProcurementGRN (not
/// GoodsReceipt) to avoid colliding with Inventory's existing
/// GoodsReceipt/GoodsReceiptLine models, which represent warehouse
/// receipts of any origin. Posting a ProcurementGRN calls
/// InventoryService to record the StockMovement/StockBalance update
/// rather than duplicating that logic here.
model ProcurementGRN {
  id              String               @id @default(uuid())
  entityId        String
  grnNumber       String
  purchaseOrderId String
  vendorId        String
  warehouseId     String
  receiptDate     DateTime
  referenceNumber String?
  status          ProcurementGRNStatus @default(DRAFT)

  // GL account credited for the GR/IR (goods-received-not-invoiced)
  // accrual at receipt time. Persisted so 3-way-match completion can
  // debit this same account to clear the accrual, instead of
  // re-debiting the expense/inventory account and double-posting cost.
  grIrClearingAccountId String

  createdById String
  createdAt   DateTime @default(now())
  postedAt    DateTime?

  entity            Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendor            Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy         User          @relation("ProcurementGRNCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  grIrClearingAccount Account     @relation(fields: [grIrClearingAccountId], references: [id], onDelete: Restrict)

  lines           ProcurementGRNLine[]
  threeWayMatches ThreeWayMatch[]

  @@unique([entityId, grnNumber])
  @@index([purchaseOrderId])
  @@map("procurement_grns")
}

model ProcurementGRNLine {
  id                  String  @id @default(uuid())
  grnId               String
  purchaseOrderLineId String
  stockItemId         String?
  quantityReceived    Decimal @db.Decimal(18, 4)
  unitCost            Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  grn             ProcurementGRN    @relation(fields: [grnId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  stockItem       StockItem?        @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([grnId])
  @@index([purchaseOrderLineId])
  @@map("procurement_grn_lines")
}

model VendorInvoice {
  id              String              @id @default(uuid())
  entityId        String
  invoiceNumber   String
  vendorId        String
  purchaseOrderId String?
  invoiceDate     DateTime
  dueDate         DateTime?
  status          VendorInvoiceStatus @default(DRAFT)

  // Running total of gross amount settled via posted PaymentVoucher
  // allocations. Open balance for aging/statements = invoice total -
  // amountPaid. Maintained by AccountsPayableService when a payment
  // voucher posts, mirroring how PurchaseOrderLine.quantityReceived is
  // maintained by ProcurementService.
  amountPaid Decimal @db.Decimal(18, 2) @default(0)

  createdById String
  createdAt   DateTime @default(now())
  postedAt    DateTime?

  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("VendorInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  lines           VendorInvoiceLine[]
  threeWayMatches ThreeWayMatch[]
  paymentAllocations PaymentVoucherAllocation[]
  // Phase 5A Ã¢â‚¬â€ Facility Management / Maintenance Requests (additive):
  // set when this bill was raised via MaintenanceService billing a
  // vendor for repair work (see MaintenanceRequest.vendorInvoiceId).
  maintenanceRequest MaintenanceRequest?

  @@unique([entityId, vendorId, invoiceNumber])
  @@index([purchaseOrderId])
  @@map("vendor_invoices")
}

model VendorInvoiceLine {
  id                  String  @id @default(uuid())
  vendorInvoiceId     String
  purchaseOrderLineId String?
  description         String
  accountId            String
  quantity             Decimal @db.Decimal(18, 4)
  unitCost             Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  vendorInvoice     VendorInvoice      @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([vendorInvoiceId])
  @@index([purchaseOrderLineId])
  @@map("vendor_invoice_lines")
}

/// Result of matching a PO against its GRN(s) and Vendor Invoice on
/// quantity and price. Completing a match with no variance (or a
/// variance within tolerance) is what triggers the AP voucher Ã¢â‚¬â€
/// implemented in Phase B as a call from ProcurementService into the
/// (then-existing) APService, keeping this model's `status` as the
/// single source of truth for "is this invoice safe to pay".
model ThreeWayMatch {
  id              String              @id @default(uuid())
  purchaseOrderId String
  grnId           String
  vendorInvoiceId String
  status          ThreeWayMatchStatus @default(PENDING)

  quantityVarianceQty   Decimal? @db.Decimal(18, 4)
  priceVarianceAmount   Decimal? @db.Decimal(18, 2)
  notes                 String?

  matchedById String?
  matchedAt   DateTime?

  createdAt DateTime @default(now())

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  grn           ProcurementGRN @relation(fields: [grnId], references: [id], onDelete: Restrict)
  vendorInvoice VendorInvoice  @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)
  matchedBy     User?          @relation("ThreeWayMatchMatchedBy", fields: [matchedById], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, grnId, vendorInvoiceId])
  @@index([vendorInvoiceId])
  @@map("three_way_matches")
}

// =====================================================================
// ACCOUNTS PAYABLE (Phase B)
// Builds on Procurement's VendorInvoice/VendorInvoiceLine (Phase A) as
// the single AP invoice record Ã¢â‚¬â€ deliberately NOT duplicated as a
// separate APInvoice/APInvoiceLine pair, for the same reason Phase C's
// AR installments reuse Real Estate's InstallmentSchedule rather than
// forking it. VendorInvoice.purchaseOrderId is already optional, so
// non-PO bills (rent, utilities, professional fees) post here directly
// while PO-backed bills continue through Procurement's 3-way match.
// =====================================================================

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
}

enum PaymentVoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED
}

enum PaymentBatchStatus {
  DRAFT
  APPROVED
  PROCESSED
  CANCELLED
}

enum VendorLedgerEntryType {
  INVOICE
  PAYMENT
  ADJUSTMENT
}

enum TaxRemittanceStatus {
  PENDING
  REMITTED
}

/// Vendor-scoped running balance, one row per event that changes what
/// the entity owes a vendor (invoice posted = credit, payment voucher
/// posted = debit). Kept separate from JournalLine so vendor aging /
/// statements don't have to re-derive vendor activity from the full GL.
model VendorLedger {
  id              String                @id @default(uuid())
  entityId        String
  vendorId        String
  transactionDate DateTime
  entryType       VendorLedgerEntryType
  debit           Decimal               @db.Decimal(18, 2) @default(0)
  credit          Decimal               @db.Decimal(18, 2) @default(0)
  description     String?

  // Loose reference (not an FK) to the originating document Ã¢â‚¬â€ a
  // VendorInvoice or PaymentVoucher id Ã¢â‚¬â€ mirroring the same pattern
  // already used by BudgetCommitment.sourceId.
  referenceType String
  referenceId   String

  journalEntryId String?

  createdAt DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([entityId, vendorId])
  @@index([referenceType, referenceId])
  @@map("vendor_ledger_entries")
}

model PaymentBatch {
  id           String             @id @default(uuid())
  entityId     String
  batchNumber  String
  paymentDate  DateTime
  status       PaymentBatchStatus @default(DRAFT)

  createdById  String
  approvedById String?
  approvedAt   DateTime?
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity     Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy  User            @relation("PaymentBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("PaymentBatchApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  vouchers   PaymentVoucher[]

  @@unique([entityId, batchNumber])
  @@map("payment_batches")
}

model PaymentVoucher {
  id            String               @id @default(uuid())
  entityId      String
  voucherNumber String
  vendorId      String
  batchId       String?
  paymentDate   DateTime
  paymentMethod PaymentMethod
  bankAccountId String
  status        PaymentVoucherStatus @default(DRAFT)

  createdById  String
  approvedById String?
  approvedAt   DateTime?
  postedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  batch       PaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("PaymentVoucherCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?       @relation("PaymentVoucherApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  allocations PaymentVoucherAllocation[]

  @@unique([entityId, voucherNumber])
  @@index([vendorId])
  @@map("payment_vouchers")
}

/// One row per vendor invoice a PaymentVoucher settles (fully or
/// partially), so a single voucher can pay several invoices and a
/// single invoice can be paid across several vouchers.
model PaymentVoucherAllocation {
  id               String  @id @default(uuid())
  paymentVoucherId String
  vendorInvoiceId  String
  amountAllocated  Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  paymentVoucher PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Restrict)
  vendorInvoice  VendorInvoice  @relation(fields: [vendorInvoiceId], references: [id], onDelete: Restrict)

  whtDeduction WHTDeduction?
  vatDeduction VATDeduction?

  @@index([paymentVoucherId])
  @@index([vendorInvoiceId])
  @@map("payment_voucher_allocations")
}

/// Withholding tax deducted from a specific invoice allocation at
/// payment time. The withheld amount reduces cash paid to the vendor
/// but still fully settles that portion of the vendor's payable Ã¢â‚¬â€ it
/// becomes a separate liability owed to the tax authority instead.
model WHTDeduction {
  id                         String               @id @default(uuid())
  entityId                   String
  paymentVoucherAllocationId String               @unique
  rate                       Decimal              @db.Decimal(6, 4)
  amount                     Decimal              @db.Decimal(18, 2)
  taxAuthorityAccountId      String
  certificateNumber          String?
  status                     TaxRemittanceStatus  @default(PENDING)
  remittedAt                 DateTime?

  createdAt DateTime @default(now())

  entity                   Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  paymentVoucherAllocation PaymentVoucherAllocation @relation(fields: [paymentVoucherAllocationId], references: [id], onDelete: Restrict)
  taxAuthorityAccount      Account                  @relation("WHTTaxAuthorityAccount", fields: [taxAuthorityAccountId], references: [id], onDelete: Restrict)

  @@map("wht_deductions")
}

/// Same mechanics as WHTDeduction for jurisdictions where the buyer
/// withholds VAT and remits it directly rather than paying it to the
/// vendor as part of the invoice.
model VATDeduction {
  id                         String               @id @default(uuid())
  entityId                   String
  paymentVoucherAllocationId String               @unique
  rate                       Decimal              @db.Decimal(6, 4)
  amount                     Decimal              @db.Decimal(18, 2)
  taxAuthorityAccountId      String
  status                     TaxRemittanceStatus  @default(PENDING)
  remittedAt                 DateTime?

  createdAt DateTime @default(now())

  entity                   Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  paymentVoucherAllocation PaymentVoucherAllocation @relation(fields: [paymentVoucherAllocationId], references: [id], onDelete: Restrict)
  taxAuthorityAccount      Account                  @relation("VATTaxAuthorityAccount", fields: [taxAuthorityAccountId], references: [id], onDelete: Restrict)

  @@map("vat_deductions")
}

// =====================================================================
// ACCOUNTS RECEIVABLE (Phase C)
// Installment plans deliberately reuse Real Estate's existing
// InstallmentSchedule/InstallmentLine models rather than a parallel
// ARInstallmentPlan/InstallmentLine pair (confirmed choice Ã¢â‚¬â€ same
// customer-installment concept, and a second InstallmentLine model
// would collide by name in this schema anyway).
// =====================================================================

enum ARInvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CustomerLedgerEntryType {
  INVOICE
  RECEIPT
  ADJUSTMENT
}

model ARInvoice {
  id            String          @id @default(uuid())
  entityId      String
  invoiceNumber String
  customerId    String
  // Optional link back to a Real Estate sale, so a unit handover /
  // installment plan can have a matching AR invoice without forcing
  // every AR invoice (service income, non-unit receivables) through
  // the Real Estate flow.
  allocationId  String?
  invoiceDate   DateTime
  dueDate       DateTime?
  status        ARInvoiceStatus @default(DRAFT)

  // Running total settled via posted Receipt allocations. Open balance
  // for aging/statements = invoice total - amountReceived.
  amountReceived Decimal @db.Decimal(18, 2) @default(0)

  createdById String
  createdAt   DateTime @default(now())
  postedAt    DateTime?

  entity     Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict)
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocation UnitSaleAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("ARInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  lines               ARInvoiceLine[]
  receiptAllocations  ReceiptAllocation[]
  // Phase 5A Ã¢â‚¬â€ Lease Management (additive): set when this invoice was
  // generated as a periodic rent billing rather than a unit-sale invoice.
  leaseRentInvoice    LeaseRentInvoice?

  @@unique([entityId, invoiceNumber])
  @@index([entityId, customerId])
  @@map("ar_invoices")
}

model ARInvoiceLine {
  id          String  @id @default(uuid())
  arInvoiceId String
  description String
  accountId   String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 2)

  // Present mainly so "Collections by project" can group revenue by
  // project without joining back through Real Estate for non-unit
  // receivables.
  projectId String?
  phaseId   String?

  createdAt DateTime @default(now())

  // Release L Ã¢â‚¬â€ Output VAT on AR Invoices (additive). Resolved from a
  // TaxCode at createInvoice time and snapshotted here Ã¢â‚¬â€ same pattern as
  // AP's whtTaxCodeId/vatTaxCodeId resolution (Tax Code Integration
  // release): the rate is captured at the moment of use, not looked up
  // live from TaxCode on every read, so a later rate change doesn't
  // retroactively alter an already-issued invoice. All three fields are
  // null for a line with no vatTaxCodeId Ã¢â‚¬â€ existing invoices/lines are
  // completely unaffected.
  vatRate              Decimal? @db.Decimal(6, 4)
  vatAmount            Decimal? @db.Decimal(18, 2)
  vatAuthorityAccountId String?
  vatAuthorityAccount  Account? @relation("ARInvoiceLineVatAuthority", fields: [vatAuthorityAccountId], references: [id], onDelete: Restrict)

  arInvoice ARInvoice @relation(fields: [arInvoiceId], references: [id], onDelete: Restrict)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase     Phase?    @relation(fields: [phaseId], references: [id], onDelete: Restrict)

  @@index([arInvoiceId])
  @@map("ar_invoice_lines")
}

model Receipt {
  id            String        @id @default(uuid())
  entityId      String
  receiptNumber String
  customerId    String
  receiptDate   DateTime
  paymentMethod PaymentMethod
  bankAccountId String
  status        ReceiptStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  postedAt    DateTime?

  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  allocations ReceiptAllocation[]

  @@unique([entityId, receiptNumber])
  @@map("receipts")
}

/// One row per AR invoice a Receipt settles (fully or partially) Ã¢â‚¬â€
/// mirrors PaymentVoucherAllocation on the AP side.
model ReceiptAllocation {
  id              String  @id @default(uuid())
  receiptId       String
  arInvoiceId     String
  amountAllocated Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  receipt   Receipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  arInvoice ARInvoice @relation(fields: [arInvoiceId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([arInvoiceId])
  @@map("receipt_allocations")
}

/// Customer-scoped running balance, mirroring VendorLedger on the AP
/// side: INVOICE increases the balance (debit, since AR control is a
/// debit-normal asset account), RECEIPT decreases it (credit).
model CustomerLedger {
  id              String                   @id @default(uuid())
  entityId        String
  customerId      String
  transactionDate DateTime
  entryType       CustomerLedgerEntryType
  debit           Decimal                  @db.Decimal(18, 2) @default(0)
  credit          Decimal                  @db.Decimal(18, 2) @default(0)
  description     String?

  referenceType String
  referenceId   String

  journalEntryId String?

  createdAt DateTime @default(now())

  entity       Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([entityId, customerId])
  @@index([referenceType, referenceId])
  @@map("customer_ledger_entries")
}

// =====================================================================
// BANK RECONCILIATION (Phase D)
// Links to Treasury's existing BankAccount. Reconciliation itself
// compares BankStatementLine rows (the bank's version of events)
// against JournalLine rows already posted to that account's GL account
// (the book's version) Ã¢â‚¬â€ no separate "book transaction" model is
// introduced, since JournalLine already is that.
// =====================================================================

enum ReconciliationSessionStatus {
  DRAFT
  APPROVED
}

enum ReconciliationMatchType {
  AUTO
  MANUAL
  ADJUSTMENT
}

model BankStatement {
  id            String   @id @default(uuid())
  entityId      String
  bankAccountId String
  statementDate DateTime
  periodStart   DateTime
  periodEnd     DateTime
  openingBalance Decimal @db.Decimal(18, 2)
  closingBalance Decimal @db.Decimal(18, 2)

  importedById String
  createdAt    DateTime @default(now())

  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  importedBy  User        @relation("BankStatementImportedBy", fields: [importedById], references: [id], onDelete: Restrict)

  lines               BankStatementLine[]
  reconciliationSessions ReconciliationSession[]

  @@index([bankAccountId, statementDate])
  @@map("bank_statements")
}

model BankStatementLine {
  id              String   @id @default(uuid())
  statementId     String
  transactionDate DateTime
  description     String
  reference       String?
  // Signed: positive = credit/deposit into the account, negative =
  // debit/withdrawal Ã¢â‚¬â€ matching how bank statements are usually
  // exported, rather than separate debit/credit columns.
  amount          Decimal  @db.Decimal(18, 2)
  isMatched       Boolean  @default(false)

  createdAt DateTime @default(now())

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  matches   ReconciliationMatch[]

  @@index([statementId])
  @@map("bank_statement_lines")
}

model ReconciliationSession {
  id             String                      @id @default(uuid())
  entityId       String
  bankAccountId  String
  statementId    String
  // GL account this bank account posts to Ã¢â‚¬â€ supplied explicitly since
  // BankAccount itself carries no GL account reference (same pattern
  // used for AP/AR cash accounts).
  bankGlAccountId String
  sessionDate    DateTime
  status         ReconciliationSessionStatus @default(DRAFT)

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity      Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bankAccount BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  bankGlAccount Account     @relation(fields: [bankGlAccountId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("ReconciliationSessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?         @relation("ReconciliationSessionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  matches ReconciliationMatch[]

  @@map("reconciliation_sessions")
}

model ReconciliationMatch {
  id                  String                  @id @default(uuid())
  sessionId           String
  bankStatementLineId String
  // Loose reference (not an FK, same pattern as BudgetCommitment.sourceId)
  // to the JournalLine this statement line was matched against Ã¢â‚¬â€ or, for
  // bank charges / interest income raised during reconciliation, to the
  // JournalLine of the adjustment entry created for that purpose.
  journalLineId       String?
  matchType           ReconciliationMatchType
  matchedAmount        Decimal                 @db.Decimal(18, 2)
  notes                String?

  createdById String
  createdAt   DateTime @default(now())

  session           ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  bankStatementLine BankStatementLine     @relation(fields: [bankStatementLineId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation("ReconciliationMatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([bankStatementLineId])
  @@map("reconciliation_matches")
}

// =====================================================================
// WORKFLOW ENGINE (Enterprise Platform Upgrade Ã¢â‚¬â€ Phase D)
// A single reusable approval/state-machine engine, so future work can
// stop hand-rolling maker-checker logic per module the way Procurement,
// AP, and Budgeting currently do. Deliberately additive and NOT wired
// into those existing modules yet Ã¢â‚¬â€ they keep working exactly as they
// do today. Migrating them onto this engine is a separate, explicit
// follow-up so nothing working today silently changes behavior.
// =====================================================================

enum WorkflowStageType {
  DRAFT
  SUBMITTED
  REVIEW
  APPROVAL
  POSTED
  ARCHIVED
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  RETURNED
  POSTED
  ARCHIVED
  CANCELLED
}

enum WorkflowStageInstanceStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
}

enum WorkflowActionType {
  SUBMIT
  REVIEW
  APPROVE
  REJECT
  RETURN
  POST
  ARCHIVE
  COMMENT
}

enum WorkflowRuleField {
  AMOUNT
  DEPARTMENT
  PROJECT
  ENTITY
  ROLE
  RISK_LEVEL
  BUDGET_AVAILABILITY
}

enum WorkflowRuleOperator {
  GT
  GTE
  LT
  LTE
  EQ
  NEQ
  IN
}

/// A reusable pipeline template Ã¢â‚¬â€ e.g. "Standard Purchase Approval",
/// "High-Value Payment Approval" Ã¢â‚¬â€ identified by `code`, not tied to
/// any one domain model. `entityType` is a free-text label (e.g.
/// "PurchaseOrder", "PaymentVoucher") describing what it's meant for,
/// purely for admin-UI filtering Ã¢â‚¬â€ the engine itself doesn't care.
model WorkflowDefinition {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  entityType  String
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    WorkflowStageDefinition[]
  rules     WorkflowApprovalRule[]
  instances WorkflowInstance[]

  @@map("workflow_definitions")
}

/// One node in the pipeline. Multiple APPROVAL-type stages in sequence
/// give "unlimited approval levels" (e.g. Dept Head -> Finance Manager
/// -> CFO), each independently subject to WorkflowApprovalRule.
model WorkflowStageDefinition {
  id                   String            @id @default(uuid())
  workflowDefinitionId String
  sequence             Int
  name                 String
  stageType            WorkflowStageType
  // Role code (Role.code) required to act on this stage, when the
  // stage isn't conditionally assigned by a rule below.
  requiredRoleCode     String?
  minApprovals         Int               @default(1)

  createdAt DateTime @default(now())

  // CASCADE justified: a stage definition has no meaning outside its parent workflow template;
  // this is config/structure, not workflow execution history (which is Restrict elsewhere).
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  rules              WorkflowApprovalRule[]
  stageInstances     WorkflowStageInstance[]

  @@unique([workflowDefinitionId, sequence])
  @@map("workflow_stage_definitions")
}

/// A no-code condition, e.g. "IF AMOUNT GT 10000000 THEN require role
/// CFO on stage X" (stageDefinitionId set), or "skip stage X entirely
/// unless AMOUNT GT ..." When stageDefinitionId is null the rule is
/// evaluated at workflow-start time to decide which stages apply at
/// all (skipping ones with an unmet rule); when set, it instead
/// overrides that stage's requiredRoleCode for this instance.
model WorkflowApprovalRule {
  id                   String                @id @default(uuid())
  workflowDefinitionId String
  stageDefinitionId    String?
  field                WorkflowRuleField
  operator             WorkflowRuleOperator
  // JSON-encoded comparison value Ã¢â‚¬â€ a number for AMOUNT, a string for
  // DEPARTMENT/PROJECT/ENTITY/ROLE/RISK_LEVEL, a boolean for
  // BUDGET_AVAILABILITY Ã¢â‚¬â€ since the value type varies by field.
  value                String
  requiredRoleCode     String?
  description          String?

  createdAt DateTime @default(now())

  // CASCADE justified: pure template structure (approval rule belongs only to its workflow
  // definition/stage definition), never itself execution history. WorkflowInstance/WorkflowStageInstance
  // (the actual execution audit trail) are Restrict below.
  workflowDefinition WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  stageDefinition    WorkflowStageDefinition? @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)

  @@map("workflow_approval_rules")
}

/// One running (or completed) approval process for a specific domain
/// record. `entityType`/`entityId` are a loose reference (same pattern
/// as BudgetCommitment.sourceId) Ã¢â‚¬â€ e.g. entityType="PurchaseOrder",
/// entityId=PurchaseOrder.id Ã¢â‚¬â€ so this engine never needs a migration
/// to support a new consuming module.
model WorkflowInstance {
  id                   String                 @id @default(uuid())
  workflowDefinitionId String
  entityType           String
  entityId             String
  status               WorkflowInstanceStatus @default(IN_PROGRESS)
  // Snapshot of the fields rules are evaluated against Ã¢â‚¬â€ amount,
  // departmentId, projectId, entityId (the accounting Entity, not to
  // be confused with entityType/entityId above), role, riskLevel,
  // budgetAvailable Ã¢â‚¬â€ captured once at start so later edits to the
  // underlying record can't retroactively change which approvals were
  // required for it.
  context              Json

  startedById String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflowDefinition WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  startedBy          User                    @relation("WorkflowInstanceStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  stageInstances     WorkflowStageInstance[]
  actions            WorkflowAction[]

  @@index([entityType, entityId])
  @@index([workflowDefinitionId, status])
  @@map("workflow_instances")
}

model WorkflowStageInstance {
  id                String                      @id @default(uuid())
  workflowInstanceId String
  stageDefinitionId String
  sequence          Int
  status            WorkflowStageInstanceStatus @default(PENDING)
  requiredRoleCode  String?
  requiredApprovals Int                         @default(1)
  approvalsReceived Int                         @default(0)

  activatedAt DateTime?
  completedAt DateTime?

  workflowInstance WorkflowInstance        @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)
  stageDefinition  WorkflowStageDefinition  @relation(fields: [stageDefinitionId], references: [id], onDelete: Restrict)
  actions          WorkflowAction[]

  @@unique([workflowInstanceId, sequence])
  @@map("workflow_stage_instances")
}

/// Full audit trail: every submit/review/approve/reject/return/post
/// action taken against a stage, by whom, and any comments.
model WorkflowAction {
  id                 String             @id @default(uuid())
  workflowInstanceId String
  stageInstanceId    String
  actorId            String
  action             WorkflowActionType
  comments           String?

  actedAt DateTime @default(now())

  workflowInstance WorkflowInstance      @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)
  stageInstance    WorkflowStageInstance @relation(fields: [stageInstanceId], references: [id], onDelete: Restrict)
  actor            User                  @relation("WorkflowActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workflowInstanceId])
  @@map("workflow_actions")
}

// =====================================================================
// ADMIN & BRANDING PLATFORM (Enterprise Platform Upgrade Ã¢â‚¬â€ Phase A)
// Per-entity branding, document templates, and locale/format settings.
// Deliberately does NOT duplicate Entity.baseCurrency or
// Entity.fiscalYearStartMonth, which already exist Ã¢â‚¬â€ this only adds
// what Entity doesn't already carry (theme, assets, templates, locale
// display formatting). File assets (logos, letterheads, watermarks,
// signatures, stamps) store a storage key + URL from the pluggable
// StorageProvider (see apps/api/src/storage) rather than binary data.
// =====================================================================

enum BrandAssetType {
  LOGO
  LETTERHEAD
  WATERMARK
  DIGITAL_SIGNATURE
  STAMP
}

enum DocumentTemplateType {
  EMAIL
  INVOICE
  PURCHASE_ORDER
  RECEIPT
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum CurrencySymbolPosition {
  BEFORE
  AFTER
}

/// One row per entity: theme, locale, and format preferences. Doesn't
/// duplicate Entity.baseCurrency / Entity.fiscalYearStartMonth, which
/// already exist on Entity Ã¢â‚¬â€ this is purely the display/branding layer
/// on top of those.
model EntityBrandingProfile {
  id       String @id @default(uuid())
  entityId String @unique

  primaryColor   String @default("#0F1B2D")
  secondaryColor String @default("#16273D")
  accentColor    String @default("#C9A227")
  themeMode      ThemeMode @default(SYSTEM)
  whiteLabelEnabled Boolean @default(false)

  language           String   @default("en")
  supportedLanguages String[] @default(["en"])
  timeZone           String   @default("Africa/Lagos")
  dateFormat         String   @default("DD/MM/YYYY")
  decimalSeparator   String   @default(".")
  thousandsSeparator String   @default(",")
  currencySymbolPosition CurrencySymbolPosition @default(BEFORE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@map("entity_branding_profiles")
}

/// A branding file (logo, letterhead, watermark, signature, or stamp).
/// Multiple rows per entity per type are allowed (e.g. several logo
/// variants) with one flagged `isDefault` per (entity, assetType).
model BrandAsset {
  id         String         @id @default(uuid())
  entityId   String
  assetType  BrandAssetType
  label      String
  // Storage key + resolved URL from the pluggable StorageProvider.
  storageKey String
  url        String
  isDefault  Boolean        @default(false)

  uploadedById String
  createdAt    DateTime @default(now())

  entity     Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation("BrandAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityId, assetType])
  @@map("brand_assets")
}

/// A merge-tag document template (email body, invoice layout, PO
/// layout, receipt layout). `content` carries the template markup;
/// rendering/merge-tag substitution is a presentation-layer concern
/// left to whatever renders it (e.g. the Notification platform in a
/// later phase), not this model.
model DocumentTemplate {
  id           String               @id @default(uuid())
  entityId     String
  templateType DocumentTemplateType
  code         String
  name         String
  subject      String?
  content      String               @db.Text
  isDefault    Boolean              @default(false)
  isActive     Boolean              @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)
  createdBy User   @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([entityId, templateType, code])
  @@map("document_templates")
}

/// Company-profile fields for a legal entity that don't belong on the
/// Financial Kernel's Entity model (contact details, address, a short
/// description) Ã¢â‚¬â€ extends Entity 1:1 without modifying it.
model EntityProfile {
  id           String  @id @default(uuid())
  entityId     String  @unique
  website      String?
  supportEmail String?
  supportPhone String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@map("entity_profiles")
}

/// Per-user overrides layered on top of an entity's branding defaults
/// (EntityBrandingProfile) Ã¢â‚¬â€ dark mode and language are personal
/// preferences, not just a company-wide setting. Reuses ThemeMode
/// rather than a second theme enum.
model UserPreference {
  id       String     @id @default(uuid())
  userId   String     @unique
  theme    ThemeMode?
  language String?
  timezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_preferences")
}

/// Minimal admin-manageable i18n store: (locale, namespace, key) ->
/// value. Deliberately not a full translation-management product Ã¢â‚¬â€
/// just enough for "Multi-language" to be a real, queryable capability
/// rather than a single hardcoded `language` string with no content
/// behind it.
model TranslationEntry {
  id        String @id @default(uuid())
  locale    String
  namespace String
  key       String
  value     String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([locale, namespace, key])
  @@index([locale, namespace])
  @@map("translation_entries")
}

// =====================================================================
// HRMS Ã¢â‚¬â€ EMPLOYEE LIFECYCLE (Phase A: master data, onboarding, leave,
// attendance/shift, biometric abstraction, disciplinary, asset
// assignment, exit & clearance)
//
// Actor references on these models (raisedById, clearedById, etc.) are
// deliberately plain string columns, not FK relations to User Ã¢â‚¬â€ at this
// schema size adding a named relation + User back-relation for every
// such field would balloon the User model for little benefit, since the
// global AuditLog already captures who-did-what. employeeId references
// are real FKs throughout since they're core to the domain.
// =====================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  PROBATION
  CONFIRMED
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  documentType String // e.g. "ID Card", "Employment Contract", "Degree Certificate"
  fileUrl      String
  description  String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeNextOfKin {
  id           String  @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  address      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_next_of_kin")
}

model EmployeeEmergencyContact {
  id           String @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

enum AssetAssignmentStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
}

model EmployeeAssetAssignment {
  id           String                 @id @default(uuid())
  employeeId   String
  assetTag     String?
  assetName    String
  description  String?
  assignedDate DateTime               @default(now())
  returnedDate DateTime?
  condition    String?
  status       AssetAssignmentStatus  @default(ASSIGNED)
  issuedById   String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_asset_assignments")
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model OnboardingTask {
  id            String               @id @default(uuid())
  employeeId    String
  taskName      String
  description   String?
  dueDate       DateTime?
  status        OnboardingTaskStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_onboarding_tasks")
}

model LeaveType {
  id                  String  @id @default(uuid())
  entityId            String
  code                String
  name                String
  daysPerYear         Int
  isPaid              Boolean @default(true)
  carryForwardAllowed Boolean @default(false)
  maxCarryForwardDays Int     @default(0)

  entity   Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([entityId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id                 String  @id @default(uuid())
  employeeId         String
  leaveTypeId        String
  year               Int
  entitledDays       Decimal @db.Decimal(6, 2)
  usedDays           Decimal @db.Decimal(6, 2) @default(0)
  carriedForwardDays Decimal @db.Decimal(6, 2) @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id              String             @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  daysRequested   Decimal            @db.Decimal(6, 2)
  reason          String?
  status          LeaveRequestStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@map("leave_requests")
}

model PublicHoliday {
  id       String   @id @default(uuid())
  entityId String
  name     String
  date     DateTime

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@unique([entityId, date])
  @@map("public_holidays")
}

model Shift {
  id           String @id @default(uuid())
  entityId     String
  code         String
  name         String
  startTime    String // "08:00"
  endTime      String // "17:00"
  breakMinutes Int    @default(0)

  entity      Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]

  @@unique([entityId, code])
  @@map("shifts")
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  employeeId String
  shiftId    String
  date       DateTime

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([shiftId])
  @@map("shift_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
  MOBILE
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  source     AttendanceSource @default(MANUAL)
  status     AttendanceStatus @default(PRESENT)
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

/// Vendor-neutral abstraction: any biometric terminal (fingerprint, face,
/// card) pushes raw punches here via a small adapter, keyed by whatever
/// employee code the device knows. reconcileBiometricEvents() then maps
/// rawEmployeeCode -> Employee.employeeCode and folds punches into
/// AttendanceRecord. No specific hardware SDK is wired in.
model BiometricDevice {
  id               String  @id @default(uuid())
  entityId         String
  name             String
  location         String?
  deviceIdentifier String
  isActive         Boolean @default(true)

  entity Entity              @relation(fields: [entityId], references: [id], onDelete: Restrict)
  events BiometricEventLog[]

  @@unique([entityId, deviceIdentifier])
  @@map("biometric_devices")
}

enum BiometricEventType {
  CLOCK_IN
  CLOCK_OUT
}

model BiometricEventLog {
  id              String             @id @default(uuid())
  deviceId        String
  employeeId      String?
  rawEmployeeCode String
  eventType       BiometricEventType
  eventTime       DateTime
  processed       Boolean            @default(false)
  processedAt     DateTime?

  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([deviceId, processed])
  @@index([employeeId])
  @@map("biometric_event_logs")
}

enum DisciplinaryCaseType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  TERMINATION_RECOMMENDATION
}

enum DisciplinaryCaseStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
  APPEALED
}

model DisciplinaryCase {
  id          String                  @id @default(uuid())
  employeeId  String
  caseType    DisciplinaryCaseType
  description String
  raisedById  String
  raisedAt    DateTime                @default(now())
  status      DisciplinaryCaseStatus  @default(OPEN)
  outcome     String?
  closedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@map("disciplinary_cases")
}

enum ExitType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  END_OF_CONTRACT
}

enum ExitClearanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model EmployeeExit {
  id              String               @id @default(uuid())
  employeeId      String               @unique
  exitType        ExitType
  noticeDate      DateTime
  lastWorkingDate DateTime
  reason          String?
  clearanceStatus ExitClearanceStatus  @default(PENDING)
  clearedAt       DateTime?
